<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_alba_loan_application_decision_wizard_form" model="ir.ui.view">
            <field name="name">alba.loan.application.decision.wizard.form</field>
            <field name="model">alba.loan.application.decision.wizard</field>
            <!-- FIX: removed deprecated <field name="type">form</field> -->
            <field name="arch" type="xml">
                <form string="Loan Application Decision">
                    <sheet>
                        <group>
                            <field name="application_id"/>
                            <field name="decision"/>
                            <field name="reason_id" options="{'no_create_edit': True}"/>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
