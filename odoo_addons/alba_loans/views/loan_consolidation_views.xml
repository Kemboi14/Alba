<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         alba.loan.consolidation — List View
         ================================================================ -->
    <record id="view_loan_consolidation_list" model="ir.ui.view">
        <field name="name">alba.loan.consolidation.tree</field>
        <field name="model">alba.loan.consolidation</field>
        <!-- FIX: removed deprecated <field name="type">list</field> -->
        <field name="arch" type="xml">
            <list decoration-muted="state == 'rejected'"
                  decoration-success="state == 'completed'"
                  decoration-info="state == 'quoted'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="loan_count"/>
                <field name="total_outstanding"/>
                <field name="consolidated_amount"/>
                <field name="monthly_savings"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         alba.loan.consolidation — Form View
         ================================================================ -->
    <record id="view_loan_consolidation_form" model="ir.ui.view">
        <field name="name">alba.loan.consolidation.form</field>
        <field name="model">alba.loan.consolidation</field>
        <!-- FIX: removed deprecated <field name="type">form</field> -->
        <field name="arch" type="xml">
            <form string="Loan Consolidation">
                <header>
                    <button name="action_generate_quote"
                            string="Generate Quote"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'quoted'"/>
                    <button name="action_settle_loans"
                            string="Settle Old Loans"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_create_consolidated_loan"
                            string="Create New Loan"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'settled'"/>
                    <button name="action_complete"
                            string="Complete"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'disbursed'"/>
                    <!-- FIX: also hide Reject on already-rejected records -->
                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            invisible="state in ('completed', 'rejected')"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,quoted,approved,settled,disbursed,completed"/>
                </header>

                <sheet>
                    <!-- FIX: oe_button_box moved BEFORE oe_title and ribbons
                         (standard Odoo layout order) -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_customer"
                                string="View Customer"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user"/>
                        <button name="action_view_loans"
                                string="View Loans"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list"/>
                    </div>

                    <widget name="web_ribbon" text="Draft"     bg_color="bg-warning"   invisible="state != 'draft'"/>
                    <widget name="web_ribbon" text="Quoted"    bg_color="bg-info"      invisible="state != 'quoted'"/>
                    <widget name="web_ribbon" text="Approved"  bg_color="bg-success"   invisible="state != 'approved'"/>
                    <widget name="web_ribbon" text="Settled"   bg_color="bg-primary"   invisible="state != 'settled'"/>
                    <widget name="web_ribbon" text="Disbursed" bg_color="bg-secondary" invisible="state != 'disbursed'"/>
                    <widget name="web_ribbon" text="Completed" bg_color="bg-success"   invisible="state != 'completed'"/>
                    <widget name="web_ribbon" text="Rejected"  bg_color="bg-danger"    invisible="state != 'rejected'"/>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="customer_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="loan_ids"
                                   widget="many2many_tags"
                                   domain="[('customer_id', '=', customer_id), ('state', 'in', ['active', 'overdue'])]"
                                   readonly="state != 'draft'"/>
                            <field name="loan_count"   readonly="1"/>
                            <field name="currency_id"  invisible="1"/>
                        </group>
                        <group>
                            <field name="is_eligible"            readonly="1"/>
                            <field name="eligibility_warnings"   readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="total_outstanding"  readonly="1"/>
                            <field name="total_principal"    readonly="1"/>
                            <field name="old_combined_emi"   readonly="1"/>
                            <field name="weighted_avg_rate"  readonly="1"/>
                        </group>
                        <group>
                            <field name="consolidation_type"   readonly="state != 'draft'"/>
                            <field name="consolidated_amount"  readonly="state != 'draft'"/>
                            <field name="new_interest_rate"    readonly="state != 'draft'"/>
                            <field name="new_tenure_months"    readonly="state != 'draft'"/>
                            <field name="new_emi"              readonly="1"/>
                            <field name="monthly_savings"      readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="quote_date"        readonly="1"/>
                            <field name="quote_valid_until" readonly="1"/>
                        </group>
                        <group>
                            <field name="journal_id"
                                   options="{'no_create': True}"
                                   required="state == 'approved'"/>
                            <field name="payment_method_line_id"
                                   readonly="state not in ('draft', 'quoted', 'approved')"
                                   options="{'no_create': True}"
                                   invisible="not journal_id"
                                   required="journal_id and state == 'approved'"/>
                        </group>
                    </group>

                    </group>

                </sheet>
                <field name="comparison_chart_data" invisible="1"/>
                <field name="impact_chart_data" invisible="1"/>
                <field name="document_count" invisible="1"/>
                <div class="o_loan_modification_panel border-top pt-4 mt-4">
                    <h4 class="mb-3 text-primary">
                        <i class="fa fa-line-chart me-2"/> Summary &amp; Supporting Records
                    </h4>

                    <!-- KPI Cards -->
                    <div class="row g-3 mb-4 mx-0">
                        <div class="col-md-3 col-sm-6">
                            <div class="border rounded p-3 bg-light text-center h-100">
                                <div class="text-muted small text-uppercase">Loans Combined</div>
                                <div class="h4 mb-0 fw-bold text-primary">
                                    <field name="loan_count" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="border rounded p-3 bg-white text-center h-100">
                                <div class="text-muted small text-uppercase">Total Outstanding</div>
                                <div class="h4 mb-0 fw-bold">
                                    <field name="total_outstanding" widget="monetary" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="border rounded p-3 bg-white text-center h-100 border-success">
                                <div class="text-muted small text-uppercase">New EMI</div>
                                <div class="h4 mb-0 fw-bold text-success">
                                    <field name="new_emi" widget="monetary" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="border rounded p-3 bg-white text-center h-100 border-info">
                                <div class="text-muted small text-uppercase">Monthly Savings</div>
                                <div class="h4 mb-0 fw-bold text-info">
                                    <field name="monthly_savings" widget="monetary" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Charts -->
                    <div class="row g-3 mb-4 mx-0">
                        <div class="col-lg-6">
                            <div class="border rounded p-3 bg-white shadow-sm h-100">
                                <h6 class="text-muted text-uppercase small mb-3">Before vs After</h6>
                                <field name="comparison_chart_data"
                                       widget="loan_dashboard_charts" nolabel="1"/>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="border rounded p-3 bg-white shadow-sm h-100">
                                <h6 class="text-muted text-uppercase small mb-3">
                                    Loans &amp; Fees Breakdown
                                </h6>
                                <field name="impact_chart_data"
                                       widget="loan_dashboard_charts" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- Key Dates + Documents -->
                    <div class="row g-3 mx-0">
                        <div class="col-lg-4">
                            <group string="Key Dates">
                                <field name="create_date"    string="Created" readonly="1"/>
                                <field name="quote_date"     readonly="1"/>
                                <field name="quote_valid_until" readonly="1"/>
                                <field name="approved_date"  readonly="1" invisible="not approved_date"/>
                                <field name="approved_by"    readonly="1" invisible="not approved_by"/>
                            </group>
                            <group string="New Loan" invisible="not new_loan_id">
                                <field name="new_loan_application_id" readonly="1"/>
                                <field name="new_loan_id"             readonly="1"/>
                            </group>
                        </div>
                        <div class="col-lg-8">
                            <group string="Related Documents">
                                <field name="document_ids"
                                       nolabel="1"
                                       context="{'default_partner_id': partner_id, 'default_consolidation_id': id}">
                                    <list editable="bottom"
                                          decoration-success="state == 'verified'"
                                          decoration-danger="state == 'rejected'">
                                        <field name="name"/>
                                        <field name="document_type"/>
                                        <field name="create_date" string="Uploaded"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </group>
                        </div>
                    </div>
                </div>
                <chatter/>

            </form>
        </field>
    </record>

    <!-- ================================================================
         alba.loan.consolidation — Graph View
         ================================================================ -->
    <record id="view_loan_consolidation_graph" model="ir.ui.view">
        <field name="name">alba.loan.consolidation.graph</field>
        <field name="model">alba.loan.consolidation</field>
        <!-- FIX: removed deprecated <field name="type">graph</field> -->
        <field name="arch" type="xml">
            <!-- FIX: create_date changed from type="row" to type="col"
                 for correct X-axis date grouping on a line chart -->
            <graph string="Loan Consolidations" type="line">
                <field name="create_date"          type="col"/>
                <field name="consolidated_amount"  type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================
         alba.loan.consolidation — Action Window
         ================================================================ -->
    <record id="action_loan_consolidation" model="ir.actions.act_window">
        <field name="name">Loan Consolidations</field>
        <field name="res_model">alba.loan.consolidation</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first loan consolidation quote
            </p>
            <p>
                Consolidating loans combines multiple active/overdue loans
                for a customer into a single new loan with new terms.
            </p>
        </field>
    </record>

    <!-- ================================================================
         Menu Item
         ================================================================ -->
    <menuitem id="menu_loan_consolidation"
              name="Loan Consolidations"
              parent="menu_alba_loans_root_active"
              action="action_loan_consolidation"
              sequence="25"
              groups="alba_loans.group_loan_user"/>

</odoo>