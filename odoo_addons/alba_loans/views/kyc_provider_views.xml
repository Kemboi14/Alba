<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_alba_kyc_provider_list" model="ir.ui.view">
            <field name="name">alba.kyc.provider.list</field>
            <field name="model">alba.kyc.provider</field>
            <!-- FIX: removed deprecated <field name="type">list</field> -->
            <field name="arch" type="xml">
                <list string="KYC Providers">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="provider_type"/>
                    <field name="is_active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_alba_kyc_provider_form" model="ir.ui.view">
            <field name="name">alba.kyc.provider.form</field>
            <field name="model">alba.kyc.provider</field>
            <!-- FIX: removed deprecated <field name="type">form</field> -->
            <field name="arch" type="xml">
                <form string="KYC Provider">
                    <header>
                        <button name="action_test_connection" string="Test Connection" type="object" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Active" bg_color="bg-success" invisible="not is_active"/>
                        <div class="oe_title">
                            <label for="name" string="Provider Name"/>
                            <h1><field name="name" placeholder="e.g. Smile Identity API"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="provider_type"/>
                                <field name="is_active"/>
                            </group>
                            <group invisible="provider_type == 'sandbox'">
                                <field name="api_base_url"/>
                                <field name="api_key" password="True"/>
                                <field name="api_secret" password="True"/>
                            </group>
                            
                            <group invisible="provider_type != 'custom'">
                                <field name="auth_method"/>
                                <field name="verify_endpoint"/>
                                <field name="request_format"/>
                            </group>
                            
                            <group invisible="provider_type != 'custom'">
                                <field name="success_response_path" placeholder="e.g., result.status"/>
                                <field name="custom_headers" placeholder="{'X-API-Version': 'v1'}"/>
                                <field name="response_mapping" placeholder="{'status': 'result.verification_status', 'confidence': 'result.score'}"/>
                            </group>
                        </group>
                        
                        <div class="alert alert-info mt-3" role="alert" invisible="provider_type != 'sandbox'">
                            <h4 class="alert-heading">Sandbox / Mock Provider Enabled</h4>
                            <p>This mode is for testing. It simulates KYC verification responses based on the ID number:</p>
                            <ul>
                                <li><strong>Starts with 99:</strong> Rejected (Fraud watchlist)</li>
                                <li><strong>Starts with 88:</strong> Needs Manual Review</li>
                                <li><strong>All others:</strong> Verified Successfully</li>
                            </ul>
                        </div>
                        
                        <div class="alert alert-warning mt-3" role="alert" invisible="provider_type != 'custom'">
                            <h4 class="alert-heading">Custom Provider Configuration</h4>
                            <p><strong>Authentication Methods:</strong></p>
                            <ul>
                                <li><strong>API Key:</strong> Sends key in X-API-Key header</li>
                                <li><strong>API Key + Secret:</strong> Sends both X-API-Key and X-API-Secret headers</li>
                                <li><strong>Bearer Token:</strong> Sends token in Authorization header as "Bearer token"</li>
                                <li><strong>Basic Auth:</strong> Uses HTTP Basic Authentication</li>
                                <li><strong>Custom Header:</strong> Define your own headers in JSON format</li>
                            </ul>
                            <p><strong>Response Mapping Examples:</strong></p>
                            <ul>
                                <li><code>{'status': 'result.verification_status', 'confidence': 'result.score'}</code></li>
                                <li><code>{'status': 'data.verified', 'confidence': 'data.confidence_level'}</code></li>
                            </ul>
                        </div>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_alba_kyc_provider" model="ir.actions.act_window">
            <field name="name">KYC Identity Providers</field>
            <field name="res_model">alba.kyc.provider</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_alba_kyc_provider"
                  name="KYC Providers"
                  parent="alba_loans.menu_alba_loans_config"
                  action="action_alba_kyc_provider"
                  sequence="30"
                  groups="alba_loans.group_director"/>
    </data>
</odoo>
