<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <!-- Simplified Partner Form View for Customers -->
        <record id="view_res_partner_customer_form" model="ir.ui.view">
            <field name="name">res.partner.customer.form</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <form string="Customer Contact">
                    <sheet>
                        <field name="avatar_128" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                        <div class="oe_title">
                            <field name="company_type" widget="radio" options="{'horizontal': true}"/>
                            <h1>
                                <field name="name" default_focus="1" placeholder="Contact Name" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Contact Info">
                                <field name="email" widget="email"/>
                                <field name="phone" widget="phone"/>
                                <field name="website" widget="url" placeholder="e.g. https://www.google.com"/>
                            </group>
                            <group string="Identity &amp; Tax Info">
                                <field name="id_type" invisible="company_type == 'company'"/>
                                <field name="id_number" invisible="company_type == 'company'"/>
                                <field name="date_of_birth" invisible="company_type == 'company'"/>
                                <field name="gender" invisible="company_type == 'company'"/>
                                <field name="kra_pin"/>
                                <field name="registration_number" invisible="company_type != 'company'"/>
                            </group>
                        </group>
                        <group>
                            <group string="Physical Address">
                                <span class="o_form_label o_td_label" name="address_name">
                                    <b>Address</b>
                                </span>
                                <div class="o_address_format">
                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                    <field name="city" placeholder="City" class="o_address_city"/>
                                    <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}"/>
                                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                    <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                                </div>
                            </group>
                        </group>
                        <notebook>
                            <page string="Bank Accounts" name="bank_accounts">
                                <field name="bank_ids">
                                    <list editable="bottom">
                                        <field name="bank_id"/>
                                        <field name="acc_number"/>
                                        <field name="acc_holder_name"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Accounting Settings" name="accounting" groups="account.group_account_readonly">
                                <group>
                                    <group string="Account Properties">
                                        <field name="property_account_receivable_id" options="{'no_create': True}"/>
                                        <field name="property_account_payable_id" options="{'no_create': True}"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ================================================================
             alba.customer — Form View
             ================================================================ -->
        <record id="view_alba_customer_form" model="ir.ui.view">
            <field name="name">alba.customer.form</field>
            <field name="model">alba.customer</field>
            <!-- FIX: removed deprecated <field name="type">form</field> -->
            <field name="arch" type="xml">
                <form string="Customer">
                    <header>
                        <button name="action_verify_kyc"
                                string="Manual Verify KYC"
                                type="object"
                                class="btn-secondary"
                                invisible="kyc_status == 'verified'"
                                groups="alba_loans.group_loan_manager"/>
                        <button name="action_auto_verify_kyc"
                                string="Auto-Verify KYC (API)"
                                type="object"
                                class="btn-success"
                                invisible="kyc_status == 'verified' or not id_number"
                                groups="alba_loans.group_loan_officer"/>
                        <button name="action_reject_kyc"
                                string="Reject KYC"
                                type="object"
                                class="btn-danger"
                                invisible="kyc_status in ('rejected','pending')"
                                groups="alba_loans.group_loan_officer"/>
                        <button name="action_blacklist"
                                string="Blacklist Customer"
                                type="object"
                                class="btn-danger"
                                invisible="blacklisted == True"
                                groups="alba_loans.group_loan_manager"/>
                        <field name="kyc_status" widget="statusbar"
                               statusbar_visible="pending,partial,complete,verified"/>
                    </header>

                    <sheet>
                        <field name="document_count" invisible="1"/>
                        <field name="verified_document_count" invisible="1"/>
                        <field name="kyc_progress" invisible="1"/>
                        <!-- Smart Buttons -->
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_applications"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-file-text-o">
                                <field name="loan_application_count"
                                       widget="statinfo"
                                       string="Applications"/>
                            </button>
                            <button name="action_view_loans"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-money">
                                <field name="active_loan_count"
                                       widget="statinfo"
                                       string="Active Loans"/>
                            </button>
                            <button name="action_view_loans"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-balance-scale">
                                <div class="o_stat_info">
                                    <field name="outstanding_balance" widget="monetary"/>
                                    <span class="o_stat_text">Outstanding</span>
                                </div>
                            </button>
                        </div>

                        <!-- Blacklist warning -->
                        <div class="alert alert-danger" role="alert"
                             invisible="blacklisted == False">
                            <strong>This customer is blacklisted.</strong>
                            No new loans should be disbursed.
                        </div>

                        <div class="row">
                            <div class="col-md-2 text-center">
                                <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}" readonly="0"/>
                            </div>
                            <div class="col-md-10">
                                <div class="oe_title">
                                    <label for="partner_id" string="Customer"/>
                                    <h1>
                                        <field name="partner_id"
                                               options="{'no_create': False}"
                                               context="{'form_view_ref': 'alba_loans.view_res_partner_customer_form'}"
                                               placeholder="Select or create a contact…"/>
                                    </h1>
                                </div>
                            </div>
                        </div>

                        <group>
                            <group>
                                <field name="id_type"/>
                                <field name="id_number"/>
                                <field name="date_of_birth"/>
                                <field name="age" readonly="1"/>
                                <field name="gender"/>
                                <field name="marital_status"/>
                                <field name="nationality"/>
                            </group>
                            <group>
                                <field name="county_id"/>
                                <field name="sub_county_id"/>
                                <field name="ward_id"/>
                                <field name="referral_source"/>
                                <field name="referral_name"
                                       placeholder="e.g. John Kamau"
                                       invisible="not referral_source"/>
                            </group>
                        </group>

                        <notebook>

                            <!-- ── Employment ─────────────────────────────── -->
                            <page string="Employment" name="employment">
                                <group>
                                    <group>
                                        <field name="employment_status"/>
                                        <field name="employer_id" options="{'no_create_edit': False, 'no_open': False}"/>
                                        <field name="employer_phone"/>
                                        <field name="job_title"/>
                                        <field name="months_employed"/>
                                    </group>
                                    <group>
                                        <field name="monthly_income"/>
                                        <field name="other_income"/>
                                        <field name="currency_id" invisible="1"/>
                                    </group>
                                </group>
                                <group invisible="employment_status not in ('self_employed', 'business_owner')">
                                    <group>
                                        <field name="business_name"/>
                                        <field name="business_registration_number"/>
                                        <field name="business_type"/>
                                    </group>
                                    <group>
                                        <field name="business_location"/>
                                        <field name="years_in_business"/>
                                        <field name="monthly_business_turnover"/>
                                    </group>
                                </group>
                                <group>
                                    <group>
                                        <field name="sector_id" options="{'no_create_edit': True}"/>
                                        <field name="subsector_id" options="{'no_create_edit': True}"/>
                                    </group>
                                </group>
                            </page>

                            <!-- ── KYC &amp; Risk ──────────────────────────── -->
                            <page string="KYC &amp; Risk" name="kyc_risk">
                                <group>
                                    <group string="KYC Status">
                                        <field name="kyc_status" widget="badge"
                                               decoration-success="kyc_status == 'verified'"
                                               decoration-warning="kyc_status in ('partial','complete')"
                                               decoration-danger="kyc_status == 'rejected'"
                                               decoration-info="kyc_status == 'pending'"/>
                                        <field name="kyc_progress" widget="progressbar" string="KYC Progress"/>
                                        <field name="kyc_verified_by" readonly="1" invisible="kyc_status != 'verified'"/>
                                        <field name="kyc_verified_date" readonly="1" invisible="kyc_status != 'verified'"/>
                                        <field name="blacklisted"/>
                                    </group>
                                    <group string="Risk Profile">
                                        <field name="credit_score"/>
                                        <field name="risk_rating"/>
                                        <field name="django_customer_id"
                                               groups="base.group_system"/>
                                    </group>
                                </group>
                            </page>

                            <!-- ── Banking ────────────────────────────────── -->
                            <page string="Banking" name="banking">
                                <group>
                                    <group>
                                        <field name="bank_account_id"
                                               context="{'default_partner_id': partner_id}"
                                               options="{'no_create_edit': False}"/>
                                        <field name="mpesa_number"/>
                                    </group>
                                </group>
                            </page>

                            <!-- ── Documents &amp; KYC ────────────────────────── -->
                            <page string="Documents &amp; KYC" name="documents">
                                <div class="row mb-3 mx-0 g-2 align-items-center">
                                    <div class="col-auto">
                                        <span class="badge text-bg-primary p-2">
                                            <i class="fa fa-file-pdf-o"/> <field name="document_count" nolabel="1"/> Total Documents
                                        </span>
                                    </div>
                                    <div class="col-auto">
                                        <span class="badge text-bg-success p-2">
                                            <i class="fa fa-check-circle"/> <field name="verified_document_count" nolabel="1"/> Verified
                                        </span>
                                    </div>
                                    <div class="col-auto">
                                        <field name="kyc_status" widget="badge" nolabel="1"
                                               decoration-success="kyc_status == 'verified'"
                                               decoration-warning="kyc_status in ('partial','complete')"
                                               decoration-danger="kyc_status == 'rejected'"
                                               decoration-info="kyc_status == 'pending'"/>
                                    </div>
                                </div>
                                <div class="alert alert-info py-2 mb-3" role="status">
                                    <i class="fa fa-info-circle me-1"/>
                                    Upload KYC and supporting files below. Choose the document type, add a short name, then attach the file. Use <strong>Verify</strong> once reviewed.
                                </div>
                                <field name="all_document_ids" nolabel="1"
                                       mode="list"
                                       context="{'default_customer_id': id, 'default_partner_id': partner_id, 'hide_partner': True}">
                                    <list string="Customer Documents"
                                          editable="bottom"
                                          decoration-success="state == 'verified'"
                                          decoration-danger="state == 'rejected'"
                                          decoration-info="state == 'draft'">
                                        <field name="document_type"/>
                                        <field name="name" placeholder="e.g. National ID — front"/>
                                        <field name="upload_filename" column_invisible="1"/>
                                        <field name="datas" widget="binary" filename="upload_filename" string="File"/>
                                        <field name="state" widget="badge"
                                               decoration-success="state == 'verified'"
                                               decoration-warning="state == 'draft'"
                                               decoration-danger="state == 'rejected'"/>
                                        <field name="create_date" string="Uploaded" optional="show"/>
                                        <button name="action_preview" string="Preview" type="object" icon="fa-eye"
                                                invisible="not datas"/>
                                        <button name="action_verify" string="Verify" type="object" icon="fa-check"
                                                invisible="state == 'verified'"/>
                                        <button name="action_reject_document" string="Reject" type="object" icon="fa-times"
                                                invisible="state == 'rejected'"/>
                                    </list>
                                </field>
                            </page>

                            <!-- ── Loan Applications ──────────────────────── -->
                            <page string="Loan Applications" name="applications">
                                <field name="loan_application_ids"
                                       mode="list"
                                       readonly="1"
                                       context="{'default_customer_id': id}"/>
                            </page>

                            <!-- ── Notes ─────────────────────────────────── -->
                            <page string="Notes" name="notes">
                                <field name="notes"
                                       placeholder="Internal notes about this customer…"
                                       nolabel="1"/>
                            </page>

                        </notebook>
                    </sheet>

                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ================================================================
             alba.customer — List View
             ================================================================ -->
        <record id="view_alba_customer_list" model="ir.ui.view">
            <field name="name">alba.customer.list</field>
            <field name="model">alba.customer</field>
            <!-- FIX: removed deprecated <field name="type">list</field> -->
            <field name="arch" type="xml">
                <list string="Customers"
                      decoration-danger="blacklisted == True"
                      decoration-muted="active == False">
                    <field name="partner_id" string="Name"/>
                    <field name="id_type"/>
                    <field name="id_number"/>
                    <field name="employment_status"/>
                    <field name="referral_source" optional="show"/>
                    <field name="referral_name" optional="show"/>
                    <field name="sector_id" optional="show"/>
                    <field name="subsector_id" optional="hide"/>
                    <field name="monthly_income"/>
                    <field name="kyc_status" widget="badge"
                           decoration-success="kyc_status == 'verified'"
                           decoration-warning="kyc_status in ('partial','complete')"
                           decoration-danger="kyc_status == 'rejected'"
                           decoration-info="kyc_status == 'pending'"/>
                    <field name="credit_score"/>
                    <field name="risk_rating" widget="badge"
                           decoration-success="risk_rating == 'low'"
                           decoration-warning="risk_rating == 'medium'"
                           decoration-danger="risk_rating in ('high','very_high')"/>
                    <field name="active_loan_count" string="Active Loans"/>
                    <field name="outstanding_balance"/>
                    <field name="blacklisted" widget="boolean_toggle"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <!-- ================================================================
             alba.customer — Kanban View
             ================================================================ -->
        <record id="view_alba_customer_kanban" model="ir.ui.view">
            <field name="name">alba.customer.kanban</field>
            <field name="model">alba.customer</field>
            <!-- FIX: removed deprecated <field name="type">kanban</field> -->
            <field name="arch" type="xml">
                <kanban default_group_by="kyc_status" class="o_kanban_small_column">
                    <field name="partner_id"/>
                    <field name="kyc_status"/>
                    <field name="credit_score"/>
                    <field name="active_loan_count"/>
                    <field name="outstanding_balance"/>
                    <field name="blacklisted"/>
                    <field name="currency_id"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.blacklisted.raw_value ? 'border-danger' : ''}">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="partner_id"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>Credit Score: <strong><field name="credit_score"/></strong></div>
                                    <div>Active Loans: <field name="active_loan_count"/></div>
                                    <div>Outstanding: <field name="outstanding_balance" widget="monetary"/></div>
                                </div>
                                <div class="o_kanban_record_bottom" t-if="record.blacklisted.raw_value">
                                    <span class="badge text-bg-danger">Blacklisted</span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ================================================================
             alba.customer — Search View
             ================================================================ -->
        <record id="view_alba_customer_search" model="ir.ui.view">
            <field name="name">alba.customer.search</field>
            <field name="model">alba.customer</field>
            <!-- FIX: removed deprecated <field name="type">search</field> -->
            <field name="arch" type="xml">
                <search string="Search Customers">
                    <field name="partner_id"/>
                    <field name="id_number"/>
                    <field name="employer_name"/>
                    <field name="county_id"/>
                    <field name="referral_source"/>
                    <field name="referral_name" string="Referred By"/>
                    <field name="sector_id"/>
                    <field name="subsector_id"/>
                    <separator/>
                    <filter name="kyc_pending" string="KYC Pending" domain="[('kyc_status','=','pending')]"/>
                    <filter name="kyc_partial" string="KYC Partial" domain="[('kyc_status','=','partial')]"/>
                    <filter name="kyc_verified" string="KYC Verified" domain="[('kyc_status','=','verified')]"/>
                    <filter name="kyc_rejected" string="KYC Rejected" domain="[('kyc_status','=','rejected')]"/>
                    <separator/>
                    <filter name="blacklisted" string="Blacklisted" domain="[('blacklisted','=',True)]"/>
                    <filter name="inactive" string="Archived" domain="[('active','=',False)]"/>
                    <separator/>
                    <filter name="employed" string="Employed" domain="[('employment_status','=','employed')]"/>
                    <filter name="self_employed" string="Self-Employed" domain="[('employment_status','=','self_employed')]"/>
                    <separator/>
                    <group>
                        <field name="referral_source"/>
                        <field name="sector_id"/>
                        <field name="subsector_id"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>
