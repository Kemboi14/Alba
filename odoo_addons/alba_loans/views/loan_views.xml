<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- ================================================================
         alba.loan — Form View
         ================================================================ -->
    <record id="view_alba_loan_form" model="ir.ui.view">
        <field name="name">alba.loan.form</field>
        <field name="model">alba.loan</field>
        <!-- FIX: removed deprecated <field name="type">form</field> -->
        <field name="arch" type="xml">
            <form string="Loan">
                <header>
                    <button name="action_generate_schedule" string="Generate Schedule" type="object" class="btn-primary" invisible="schedule_generated == True" groups="alba_loans.group_loan_officer"/>
                    <button name="action_post_disbursement_entry" string="Post Disbursement Entry" type="object" class="btn-primary" invisible="disbursement_move_id != False" groups="account.group_account_manager"/>
                    <button name="action_post_interest_accrual_entry" string="Post Interest Accrual" type="object" class="btn-info" groups="account.group_account_manager"/>
                    <button name="action_close" string="Close Loan" type="object" class="btn-success" invisible="state not in ('normal', 'watch', 'substandard', 'doubtful', 'loss')" groups="alba_loans.group_loan_manager"/>
                    <button name="action_write_off" string="Write Off" type="object" class="btn-danger" invisible="state not in ('normal', 'watch', 'substandard', 'doubtful', 'loss')" groups="alba_loans.group_loan_manager"/>
                    <button name="action_full_repayment" string="Full Repayment" type="object" class="btn-success" invisible="state not in ('normal', 'watch', 'substandard', 'doubtful', 'loss') or is_accrual_pending" groups="alba_loans.group_loan_officer"/>
                    <button name="action_request_topup" string="Refinance / Top-Up" type="object" class="btn-primary" invisible="(not can_request_topup) or is_accrual_pending" groups="alba_loans.group_loan_officer"/>
                    <button name="action_calculate_partial_payoff" string="Calculate Partial Payoff" type="object" class="btn-primary" invisible="state not in ('normal', 'watch', 'substandard', 'doubtful', 'loss')" groups="alba_loans.group_loan_officer"/>
                    <button name="action_sync_loan_currency_to_accounting" string="Sync Currency" type="object" class="btn-info" groups="alba_loans.group_loan_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="normal,watch,substandard,doubtful,loss,closed,written_off"/>
                </header>

                <field name="is_accrual_pending" invisible="1"/>

                <div class="alert alert-warning" role="alert" invisible="not is_accrual_pending or state not in ('normal', 'watch', 'substandard', 'doubtful', 'loss')">
                    ⚠ Interest accrual has not been posted for this period. Please click 'Post Interest Accrual' before proceeding.
                </div>

                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="not id">
                        <button name="action_view_schedule" type="object" class="oe_stat_button" icon="fa-calendar">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="remaining_tenure"/></span>
                                <span class="o_stat_text">Remaining</span>
                            </div>
                        </button>
                        <button name="action_view_repayments" type="object" class="oe_stat_button" icon="fa-credit-card">
                            <field name="repayment_count" widget="statinfo" string="Payments"/>
                        </button>
                        <button name="action_view_credit_life_claims" type="object" class="oe_stat_button" icon="fa-heartbeat">
                            <field name="credit_life_insurance_count" widget="statinfo" string="Insurance"/>
                        </button>
                        <button name="action_view_topups" type="object" class="oe_stat_button" icon="fa-refresh">
                            <field name="topup_count" widget="statinfo" string="Top-Ups"/>
                        </button>
                        <button name="action_view_partial_payoffs" type="object" class="oe_stat_button" icon="fa-calculator">
                            <field name="payoff_count" widget="statinfo" string="Payoffs"/>
                        </button>
                        <button type="object" name="action_view_repayments" class="oe_stat_button" icon="fa-balance-scale">
                            <div class="o_stat_info">
                                <field name="outstanding_balance" widget="monetary"/>
                                <span class="o_stat_text">Outstanding</span>
                            </div>
                        </button>
                        <!-- Memo: Disbursement Journal Entry -->
                        <button type="object" name="action_view_disbursement_entry"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not disbursement_move_id"
                                groups="account.group_account_user">
                            <div class="o_stat_info">
                                <field name="disbursement_move_id" options="{'no_open': True}"
                                       string="" nolabel="1" readonly="1"/>
                                <span class="o_stat_text">Disbursement JE</span>
                            </div>
                        </button>
                        <!-- Memo: Provision Journal Entry -->
                        <button type="object" name="action_view_provision_entry"
                                class="oe_stat_button" icon="fa-shield"
                                invisible="not provision_move_id"
                                groups="account.group_account_user">
                            <div class="o_stat_info">
                                <field name="provision_move_id" options="{'no_open': True}"
                                       string="" nolabel="1" readonly="1"/>
                                <span class="o_stat_text">Provision JE</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Paid" bg_color="bg-success" invisible="state != 'closed'"/>
                    <widget name="web_ribbon" title="Written Off" bg_color="bg-danger" invisible="state != 'written_off'"/>

                    <div class="oe_title">
                        <label for="loan_number" string="Loan Account"/>
                        <h1>
                            <field name="loan_number" readonly="1"/>
                        </h1>
                        <div class="o_row">
                            <field name="state" widget="badge" 
                                   decoration-success="state == 'normal'"
                                   decoration-info="state == 'watch'"
                                   decoration-warning="state == 'substandard'"
                                   decoration-danger="state in ('doubtful', 'written_off')"/>
                            <span class="badge text-bg-danger" invisible="days_in_arrears == 0">
                                <i class="fa fa-warning" title="Warning"/> <field name="days_in_arrears"/> Days Overdue
                            </span>
                        </div>
                    </div>

                    <!-- ── Repayment Dashboard ────────────────────────── -->
                    <div class="row mt-4 mb-4 border rounded p-3 bg-light mx-0 shadow-sm">
                        <div class="col-md-2 border-end text-center">
                            <div class="text-muted small text-uppercase">Principal</div>
                            <div class="h4 mb-0 fw-bold"><field name="principal_amount" widget="monetary"/></div>
                        </div>
                        <div class="col-md-2 border-end text-center text-info">
                            <div class="text-muted small text-uppercase">Net Disbursed</div>
                            <div class="h4 mb-0 fw-bold"><field name="net_disbursement_amount" widget="monetary"/></div>
                        </div>
                        <div class="col-md-2 border-end text-center text-success">
                            <div class="text-muted small text-uppercase">Total Paid</div>
                            <div class="h4 mb-0 fw-bold"><field name="total_paid" widget="monetary"/></div>
                        </div>
                        <div class="col-md-2 border-end text-center text-primary">
                            <div class="text-muted small text-uppercase">Outstanding</div>
                            <div class="h4 mb-0 fw-bold"><field name="outstanding_balance" widget="monetary"/></div>
                        </div>
                        <div class="col-md-2 border-end text-center text-danger">
                            <div class="text-muted small text-uppercase">Provision (<field name="provision_rate"/>%)</div>
                            <div class="h4 mb-0 fw-bold"><field name="provision_amount" widget="monetary"/></div>
                        </div>
                        <div class="col-md-2 text-center">
                            <div class="text-muted small text-uppercase">Collection %</div>
                            <div class="mt-1">
                                <field name="repayment_progress" widget="progressbar"/>
                            </div>
                        </div>
                    </div>

                    <!-- ── Next Repayment Info ────────────────────────── -->
                    <div class="row mb-4 px-3" invisible="state in ('closed', 'written_off')">
                        <div class="col-12 border border-primary rounded p-2 bg-white d-flex align-items-center justify-content-between">
                            <div>
                                <i class="fa fa-clock-o text-primary me-2"/>
                                <span class="text-muted small text-uppercase">Next Payment: </span>
                                <span class="fw-bold text-primary ms-1"><field name="next_payment_amount" widget="monetary"/></span>
                                <span class="text-muted ms-2 small">due on </span>
                                <span class="fw-bold"><field name="next_payment_due_date"/></span>
                            </div>
                            <span class="badge rounded-pill text-bg-danger" invisible="days_until_due &gt;= 0 or not days_until_due">
                                <field name="days_until_due"/> Days Overdue
                            </span>
                            <span class="badge rounded-pill text-bg-info" invisible="days_until_due &lt; 0 or not days_until_due">
                                <field name="days_until_due"/> Days Left
                            </span>
                        </div>
                    </div>

                    <group>
                        <group>
                            <field name="customer_id" readonly="disbursement_move_id != False"/>
                            <field name="employer_id" options="{'no_create': True, 'no_open': False}"/>
                            <field name="loan_product_id" readonly="disbursement_move_id != False"/>
                            <field name="application_id" readonly="disbursement_move_id != False"/>
                        </group>
                        <group>
                            <field name="loan_date" readonly="disbursement_move_id != False"/>
                            <field name="disbursement_date" readonly="disbursement_move_id != False"/>
                            <field name="principal_amount" readonly="disbursement_move_id != False"/>
                            <field name="interest_rate" readonly="disbursement_move_id != False"/>
                            <field name="interest_method" readonly="disbursement_move_id != False"/>
                            <field name="tenure_months" readonly="disbursement_move_id != False"/>
                            <field name="repayment_frequency" readonly="disbursement_move_id != False"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Repayment Schedule" name="schedule">
                            <field name="repayment_schedule_ids" mode="list" readonly="1">
                                <list string="Schedule" decoration-danger="status == 'overdue'" decoration-success="status == 'paid'">
                                    <field name="installment_number" string="#"/>
                                    <field name="due_date"/>
                                    <field name="opening_balance"/>
                                    <field name="principal_due"/>
                                    <field name="interest_due"/>
                                    <field name="total_due" fw_bold="1"/>
                                    <field name="total_paid" string="Paid"/>
                                    <field name="balance_due" string="Balance" decoration-danger="balance_due > 0"/>
                                    <field name="status" widget="badge" decoration-success="status == 'paid'" decoration-danger="status == 'overdue'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Repayment History" name="repayments">
                            <field name="repayment_ids" mode="list" readonly="1">
                                <list string="Repayments" decoration-success="state == 'posted'" decoration-danger="state == 'reversed'">
                                    <field name="payment_date"/>
                                    <field name="payment_reference"/>
                                    <field name="journal_id"/>
                                    <field name="move_id" optional="hide" groups="account.group_account_user"/>
                                    <field name="amount_paid" sum="Total"/>
                                    <field name="payment_method" widget="badge"/>
                                    <field name="state" widget="badge" decoration-success="state == 'posted'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Funding Sources" name="funding_sources">
                            <field name="disbursement_split_ids" mode="list" readonly="disbursement_move_id">
                                <list string="Disbursement Splits">
                                    <field name="sequence" widget="handle"/>
                                    <field name="journal_id"/>
                                    <field name="account_number"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="percentage"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'disbursed'"
                                           decoration-info="state in ('pending','approved')"
                                           decoration-danger="state == 'failed'"/>
                                    <field name="disbursement_date"/>
                                    <field name="reference_number"/>
                                </list>
                            </field>
                        </page>

                        <page string="Credit Life Insurance" name="credit_life">
                            <field name="credit_life_insurance_ids" mode="list" context="{'default_loan_id': id}">
                                <list string="Credit Life Insurance Events">
                                    <field name="insurance_number"/>
                                    <field name="event_type"/>
                                    <field name="event_date"/>
                                    <field name="outstanding_balance"/>
                                    <field name="compensation_amount"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'compensated'"
                                           decoration-info="state in ('submitted','under_review','approved')"
                                           decoration-danger="state == 'rejected'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Portfolio Quality" name="par">
                            <group>
                                <field name="days_in_arrears"/>
                                <field name="par_bucket" widget="badge" decoration-success="par_bucket == 'current'" decoration-danger="par_bucket != 'current'"/>
                                <field name="arrears_amount" widget="monetary"/>
                            </group>
                        </page>

                        <page string="Accounting" name="accounting" groups="account.group_account_user">
                            <group>
                                <group>
                                    <field name="journal_id"/>
                                    <field name="disbursement_move_id"/>
                                </group>
                                <group>
                                    <field name="django_loan_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================
         alba.loan — List View
         ================================================================ -->
    <record id="view_alba_loan_list" model="ir.ui.view">
        <field name="name">alba.loan.list</field>
        <field name="model">alba.loan</field>
        <!-- FIX: removed deprecated <field name="type">list</field> -->
        <field name="arch" type="xml">
            <list string="Loans"
                  decoration-danger="state == 'written_off'"
                  decoration-success="state == 'closed'"
                  decoration-warning="state in ('watch', 'substandard', 'doubtful')"
                  decoration-info="state == 'normal'">
                <field name="loan_number"/>
                <field name="application_id" optional="hide"/>
                <field name="loan_date" optional="show"/>
                <field name="customer_id"/>
                <field name="interest_method" optional="hide"/>
                <field name="tenure_months" optional="hide"/>
                <field name="repayment_frequency" optional="hide"/>
                <field name="sector_id" optional="hide"/>
                <field name="subsector_id" optional="hide"/>
                <field name="referral_source" optional="hide"/>
                <field name="principal_amount" sum="Total Principal"/>
                <field name="total_topup_amount" optional="hide" sum="Total Top-Ups"/>
                <field name="disbursement_date" optional="show"/>
                <field name="interest_rate" optional="show"/>
                <field name="installment_amount" optional="show"/>
                <field name="first_installment_date" optional="hide"/>
                <field name="last_installment_date" optional="hide"/>
                <field name="next_payment_due_date" optional="show"/>
                <field name="repayment_progress" widget="progressbar" string="Progress"/>
                <field name="outstanding_balance" sum="Total Outstanding"/>
                <field name="outstanding_principal" optional="hide" sum="Outstanding Principal"/>
                <field name="outstanding_interest" optional="hide" sum="Outstanding Interest"/>
                <field name="outstanding_charges" optional="hide" sum="Outstanding Charges"/>
                <field name="prepayment_amount" optional="hide" sum="Prepayments"/>
                <field name="arrears_amount" sum="Total Arrears" decoration-danger="arrears_amount > 0"/>
                <field name="days_in_arrears" string="Overdue"/>
                <field name="par_bucket" widget="badge" decoration-success="par_bucket == 'current'" decoration-danger="par_bucket != 'current'"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'normal'"
                       decoration-info="state == 'watch'"
                       decoration-warning="state == 'substandard'"
                       decoration-danger="state in ('doubtful', 'written_off')"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         alba.loan — Search View
         ================================================================ -->
    <record id="view_alba_loan_search" model="ir.ui.view">
        <field name="name">alba.loan.search</field>
        <field name="model">alba.loan</field>
        <!-- FIX: removed deprecated <field name="type">search</field> -->
        <field name="arch" type="xml">
            <search>
                <field name="loan_number"/>
                <field name="customer_id"/>
                <field name="employer_id"/>
                <field name="sector_id"/>
                <field name="subsector_id"/>
                <field name="referral_source"/>
                <field name="loan_date"/>
                <field name="disbursement_date"/>
                <field name="next_payment_due_date"/>
                <filter string="Active Loans" name="active" domain="[('state','not in',('closed','written_off'))]"/>
                <separator/>
                <filter string="Normal" name="normal" domain="[('state','=','normal')]"/>
                <filter string="Watch" name="watch" domain="[('state','=','watch')]"/>
                <filter string="Substandard" name="substandard" domain="[('state','=','substandard')]"/>
                <filter string="Doubtful" name="doubtful" domain="[('state','=','doubtful')]"/>
                <filter string="Written Off" name="written_off" domain="[('state','=','written_off')]"/>
                <filter string="Fully Repaid" name="closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter string="Overdue" name="overdue" domain="[('arrears_amount','>',0)]"/>
                <separator/>
                <group>
                    <field name="loan_product_id"/>
                    <field name="state"/>
                    <field name="par_bucket"/>
                    <field name="sector_id"/>
                    <field name="subsector_id"/>
                    <field name="referral_source"/>
                    <field name="disbursement_date"/>
                </group>
            </search>
        </field>
    </record>

</data>
</odoo>
