                                <div class="text-muted small text-uppercase">Settlement</div>
                                <div class="h4 mb-0 fw-bold text-primary"><field name="settlement_amount" widget="monetary" nolabel="1"/></div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="border rounded p-3 bg-white text-center h-100 border-info">
                                <div class="text-muted small text-uppercase">New Principal</div>
                                <div class="h4 mb-0 fw-bold text-info"><field name="new_principal" widget="monetary" nolabel="1"/></div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="border rounded p-3 bg-white text-center h-100 border-success">
                                <div class="text-muted small text-uppercase">New EMI</div>
                                <div class="h4 mb-0 fw-bold text-success"><field name="new_emi" widget="monetary" nolabel="1"/></div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="border rounded p-3 bg-white text-center h-100">
                                <div class="text-muted small text-uppercase">Monthly Savings</div>
                                <div class="h4 mb-0 fw-bold"><field name="monthly_savings" widget="monetary" nolabel="1"/></div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mb-4 mx-0">
                        <div class="col-lg-6">
                            <div class="border rounded p-3 bg-white shadow-sm h-100">
                                <h6 class="text-muted text-uppercase small mb-3">Before vs After</h6>
                                <field name="comparison_chart_data" widget="loan_dashboard_charts" nolabel="1"/>
                            </div>
