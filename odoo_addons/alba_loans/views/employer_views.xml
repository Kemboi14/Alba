<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── List View ─────────────────────────────────────────────── -->
    <record id="view_alba_employer_list" model="ir.ui.view">
        <field name="name">alba.employer.list</field>
        <field name="model">alba.employer</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Employers" decoration-muted="not is_approved">
                <field name="name"/>
                <field name="industry"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="county"/>
                <field name="employee_count" string="Employees"/>
                <field name="is_approved" widget="boolean_toggle" string="Approved"/>
            </list>
        </field>
    </record>

    <!-- ─── Form View ─────────────────────────────────────────────── -->
    <record id="view_alba_employer_form" model="ir.ui.view">
        <field name="name">alba.employer.form</field>
        <field name="model">alba.employer</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Employer">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="action_view_customers"
                                icon="fa-users">
                            <field name="employee_count"
                                   string="Employees"
                                   widget="statinfo"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Suspended / Unapproved" bg_color="text-bg-danger" invisible="is_approved"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Employer / Business Name" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Business Details">
                            <field name="industry"/>
                            <field name="is_approved" string="Approved Employer"/>
                        </group>
                        <group string="Contact Info">
                            <field name="phone" widget="phone" placeholder="e.g. +254 7XX XXX XXX"/>
                            <field name="email" widget="email" placeholder="e.g. email@company.com"/>
                            <field name="website" widget="url" placeholder="e.g. https://www.company.com"/>
                        </group>
                    </group>

                    <group>
                        <group string="Location">
                            <field name="county" placeholder="e.g. Nairobi"/>
                            <field name="sub_county" placeholder="e.g. Westlands"/>
                            <field name="address" placeholder="Physical Address"/>
                        </group>
                        <group string="HR Contact Person">
                            <field name="hr_contact_name" placeholder="Full name"/>
                            <field name="hr_contact_phone" widget="phone" placeholder="e.g. +254 7XX XXX XXX"/>
                            <field name="hr_contact_email" widget="email" placeholder="e.g. hr@company.com"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Employee Borrowers" name="borrowers">
                            <field name="customer_ids" mode="list" context="{'default_employer_id': id}">
                                <list edit="false" create="false">
                                    <field name="display_name" string="Name"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                        <page string="Guarantors" name="guarantors">
                            <field name="guarantor_ids" mode="list" context="{'default_employer_id': id}">
                                <list edit="false" create="false">
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ─── Search View ───────────────────────────────────────────── -->
    <record id="view_alba_employer_search" model="ir.ui.view">
        <field name="name">alba.employer.search</field>
        <field name="model">alba.employer</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Search Employers">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="county"/>
                <separator/>
                <filter string="Approved" name="approved" domain="[('is_approved', '=', True)]"/>
                <filter string="Not Approved" name="not_approved" domain="[('is_approved', '=', False)]"/>
                <separator/>
                <group>
                    <filter string="Industry" name="group_industry" context="{'group_by': 'industry'}"/>
                    <filter string="County" name="group_county" context="{'group_by': 'county'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── Action ────────────────────────────────────────────────── -->
    <record id="action_alba_employer" model="ir.actions.act_window">
        <field name="name">Employers</field>
        <field name="res_model">alba.employer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_alba_employer_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first employer
            </p>
            <p>
                Track businesses and organisations whose employees
                are borrowers or guarantors on Alba Capital loans.
            </p>
        </field>
    </record>

    <!-- ─── Menu ────────────────────────────────────────────────── -->
    <menuitem id="menu_alba_employer"
              name="Employers"
              parent="alba_loans.menu_alba_loans_config"
              action="action_alba_employer"
              sequence="50"
              groups="alba_loans.group_loan_manager"/>

</odoo>
