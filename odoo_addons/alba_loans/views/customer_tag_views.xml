<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<data>

    <!-- ================================================================
         Customer Tag Views
         ================================================================ -->

    <record id="view_alba_customer_tag_list" model="ir.ui.view">
        <field name="name">alba.customer.tag.tree</field>
        <field name="model">alba.customer.tag</field>
        <!-- FIX: removed deprecated <field name="type">list</field> -->
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="color" widget="color_picker"/>
                <field name="customer_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_alba_customer_tag_form" model="ir.ui.view">
        <field name="name">alba.customer.tag.form</field>
        <field name="model">alba.customer.tag</field>
        <!-- FIX: removed deprecated <field name="type">form</field> -->
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                    <separator string="Tagged Customers"/>
                    <field name="customer_count" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_alba_customer_tag_search" model="ir.ui.view">
        <field name="name">alba.customer.tag.search</field>
        <field name="model">alba.customer.tag</field>
        <!-- FIX: removed deprecated <field name="type">search</field> -->
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="risk" string="Risk Level" domain="[('category', '=', 'risk')]"/>
                <filter name="segment" string="Customer Segment" domain="[('category', '=', 'segment')]"/>
                <filter name="source" string="Lead Source" domain="[('category', '=', 'source')]"/>
            </search>
        </field>
    </record>

    <record id="action_alba_customer_tag" model="ir.actions.act_window">
        <field name="name">Customer Tags</field>
        <field name="res_model">alba.customer.tag</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_alba_customer_tag_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Customer Tag
            </p>
            <p>
                Tags help you categorize customers by risk level, segment, lead source, or custom criteria.
            </p>
        </field>
    </record>

</data>
</odoo>
