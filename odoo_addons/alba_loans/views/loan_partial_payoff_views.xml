<?xml version="1.0" encoding="utf-8"?>
<!--
  Alba Loans - Partial Payoff Views
-->
<odoo>

    <!-- ================================================================
         alba.loan.partial.payoff — List View
         ================================================================ -->
    <record id="view_loan_partial_payoff_list" model="ir.ui.view">
        <field name="name">alba.loan.partial.payoff.tree</field>
        <field name="model">alba.loan.partial.payoff</field>
        <!-- FIX: removed deprecated <field name="type">list</field> -->
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'applied'"
                  decoration-info="state == 'quoted'"
                  decoration-warning="state == 'expired'">
                <field name="name"/>
                <field name="loan_id"/>
                <field name="customer_id"/>
                <field name="payoff_amount"/>
                <field name="reduction_mode"/>
                <field name="principal_reduction"/>
                <field name="interest_saved"/>
                <field name="state"/>
                <field name="quote_valid_until"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         alba.loan.partial.payoff — Form View
         ================================================================ -->
    <record id="view_loan_partial_payoff_form" model="ir.ui.view">
        <field name="name">alba.loan.partial.payoff.form</field>
        <field name="model">alba.loan.partial.payoff</field>
        <!-- FIX: removed deprecated <field name="type">form</field> -->
        <field name="arch" type="xml">
            <form string="Loan Partial Payoff">
                <header>
                    <button name="action_generate_quote"
                            string="Create Payoff"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_archive_schedule"
                            string="Archive Existing Schedule"
                            type="object"
                            class="btn-warning"
                            invisible="state not in ('quoted', 'accepted') or not loan_id or not schedule_generated"
                            confirm="This will archive the current repayment schedule so that a new one can be generated after the payoff. Continue?"/>
                    <button name="action_apply"
                            string="Apply Payoff"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ('quoted', 'accepted')"
                            confirm="Are you sure you want to apply this partial payoff? This will post a repayment and regenerate the schedule."/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state not in ('draft', 'quoted', 'accepted')"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'expired'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,quoted,accepted,applied"/>
                </header>

                <sheet>
                    <field name="schedule_generated" invisible="1"/>
                    <widget name="web_ribbon" title="Draft"     bg_color="bg-warning"   invisible="state != 'draft'"/>
                    <widget name="web_ribbon" title="Quoted"    bg_color="bg-info"      invisible="state != 'quoted'"/>
                    <widget name="web_ribbon" title="Accepted"  bg_color="bg-primary"   invisible="state != 'accepted'"/>
                    <widget name="web_ribbon" title="Applied"   bg_color="bg-success"   invisible="state != 'applied'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-secondary" invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="Expired"   bg_color="bg-danger"    invisible="state != 'expired'"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loan"
                                string="View Loan"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-arrow-right"/>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="loan_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="customer_id"         readonly="1"/>
                            <field name="current_outstanding" readonly="1"/>
                            <field name="current_emi"         readonly="1"/>
                            <field name="remaining_tenure"    readonly="1"/>
                            <field name="currency_id"         invisible="1"/>
                        </group>
                        <group>
                            <field name="quote_date"        readonly="1"/>
                            <field name="quote_valid_until" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="payoff_amount"       readonly="state != 'draft'"/>
                            <field name="reduction_mode"      readonly="state != 'draft'"/>
                            <field name="principal_reduction" readonly="1"/>
                            <field name="interest_saved"      readonly="1"/>
                            <field name="new_outstanding"     readonly="1"/>
                        </group>
                        <group>
                            <field name="new_emi"     readonly="1"/>
                            <field name="new_tenure"  readonly="1"/>
                            <separator string="Payment"/>
                            <field name="journal_id"
                                   options="{'no_create': True}"
                                   readonly="state == 'applied'"
                                   required="state in ('quoted', 'accepted')"/>
                            <field name="payment_method_line_id"
                                   options="{'no_create': True}"
                                   invisible="not journal_id"
                                   readonly="state == 'applied'"
                                   required="journal_id and state in ('quoted', 'accepted')"/>
                            <field name="payment_date"      readonly="state == 'applied'"/>
                            <field name="payment_reference" readonly="state == 'applied'"/>
                            <field name="emi_reduction"     readonly="1" invisible="emi_reduction == 0"/>
                            <field name="tenure_reduction"  readonly="1" invisible="tenure_reduction == 0"/>
                        </group>
                    </group>

                    <group string="Processing Summary"
                           invisible="state in ('draft', 'cancelled')">
                        <group>
                            <field name="repayment_id"   readonly="1"/>
                            <field name="processed_by"   readonly="1"/>
                            <field name="processed_date" readonly="1"/>
                        </group>
                    </group>

                </sheet>
                <field name="comparison_chart_data" invisible="1"/>
                <field name="impact_chart_data" invisible="1"/>
                <field name="document_count" invisible="1"/>
                <div class="o_loan_modification_panel border-top pt-4 mt-4">
                    <h4 class="mb-3 text-primary">
                        <i class="fa fa-line-chart me-2"/> Summary &amp; Supporting Records
                    </h4>

                    <!-- KPI Cards -->
                    <div class="row g-3 mb-4 mx-0">
                        <div class="col-md-3 col-sm-6">
                            <div class="border rounded p-3 bg-light text-center h-100">
                                <div class="text-muted small text-uppercase">Payoff Amount</div>
                                <div class="h4 mb-0 fw-bold text-info">
                                    <field name="payoff_amount" widget="monetary" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="border rounded p-3 bg-white text-center h-100 border-success">
                                <div class="text-muted small text-uppercase">Principal Reduction</div>
                                <div class="h4 mb-0 fw-bold text-success">
                                    <field name="principal_reduction" widget="monetary" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="border rounded p-3 bg-white text-center h-100">
                                <div class="text-muted small text-uppercase">Interest Saved</div>
                                <div class="h4 mb-0 fw-bold text-primary">
                                    <field name="interest_saved" widget="monetary" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="border rounded p-3 bg-white text-center h-100 border-warning">
                                <div class="text-muted small text-uppercase">New Outstanding</div>
                                <div class="h4 mb-0 fw-bold text-warning">
                                    <field name="new_outstanding" widget="monetary" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Charts -->
                    <div class="row g-3 mb-4 mx-0">
                        <div class="col-lg-6">
                            <div class="border rounded p-3 bg-white shadow-sm h-100">
                                <h6 class="text-muted text-uppercase small mb-3">Before vs After</h6>
                                <field name="comparison_chart_data"
                                       widget="loan_dashboard_charts" nolabel="1"/>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="border rounded p-3 bg-white shadow-sm h-100">
                                <h6 class="text-muted text-uppercase small mb-3">Payoff Impact</h6>
                                <field name="impact_chart_data"
                                       widget="loan_dashboard_charts" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- Key Dates + Documents -->
                    <div class="row g-3 mx-0">
                        <div class="col-lg-4">
                            <group string="Key Dates">
                                <field name="create_date"    string="Created" readonly="1"/>
                                <field name="quote_date"     readonly="1"/>
                                <field name="quote_valid_until" readonly="1"/>
                                <field name="processed_date" readonly="1"
                                       invisible="not processed_date"/>
                            </group>
                            <group string="Payment Details"
                                   invisible="state in ('draft', 'cancelled', 'expired')">
                                <field name="payment_date"            readonly="1"/>
                                <field name="payment_reference"       readonly="1"/>
                                <field name="journal_id"              readonly="1"/>
                                <field name="payment_method_line_id"  readonly="1"/>
                                <field name="repayment_id"            readonly="1"/>
                                <field name="processed_by"            readonly="1"/>
                            </group>
                        </div>
                        <div class="col-lg-8">
                            <group string="Related Documents">
                                <field name="document_ids"
                                       nolabel="1"
                                       context="{
                                           'default_partner_id': partner_id,
                                           'default_loan_id': loan_id,
                                           'default_partial_payoff_id': id
                                       }">
                                    <list editable="bottom"
                                          decoration-success="state == 'verified'"
                                          decoration-danger="state == 'rejected'">
                                        <field name="name"/>
                                        <field name="document_type"/>
                                        <field name="create_date" string="Uploaded"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </group>
                        </div>
                    </div>
                </div>
                <chatter/>

            </form>
        </field>
    </record>

    <!-- ================================================================
         alba.loan.partial.payoff — Search View
         ================================================================ -->
    <record id="view_loan_partial_payoff_search" model="ir.ui.view">
        <field name="name">alba.loan.partial.payoff.search</field>
        <field name="model">alba.loan.partial.payoff</field>
        <!-- FIX: removed deprecated <field name="type">search</field> -->
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="loan_id"/>
                <field name="customer_id"/>
                <!-- FIX: added <separator/> so state filters render as a distinct group -->
                <separator/>
                <filter name="draft"   string="Draft"   domain="[('state', '=', 'draft')]"/>
                <filter name="quoted"  string="Quoted"  domain="[('state', '=', 'quoted')]"/>
                <filter name="applied" string="Applied" domain="[('state', '=', 'applied')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
            </search>
        </field>
    </record>

    <!-- ================================================================
         alba.loan.partial.payoff — Action Window
         ================================================================ -->
    <record id="action_loan_partial_payoff" model="ir.actions.act_window">
        <field name="name">Loan Partial Payoffs</field>
        <field name="res_model">alba.loan.partial.payoff</field>
        <field name="view_mode">list,form,graph</field>
        <field name="search_view_id" ref="view_loan_partial_payoff_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first partial payoff quote
            </p>
            <p>
                Partial payoffs allow customers to make extra payments
                to reduce their loan tenure or EMI.
            </p>
        </field>
    </record>

    <!-- ================================================================
         alba.loan.partial.payoff — Graph View
         ================================================================ -->
    <record id="view_loan_partial_payoff_graph" model="ir.ui.view">
        <field name="name">alba.loan.partial.payoff.graph</field>
        <field name="model">alba.loan.partial.payoff</field>
        <!-- FIX: removed deprecated <field name="type">graph</field> -->
        <field name="arch" type="xml">
            <!-- FIX: create_date changed from type="row" to type="col"
                 for correct X-axis date grouping on a line chart -->
            <graph string="Partial Payoffs" type="line">
                <field name="create_date"    type="col"/>
                <field name="payoff_amount"  type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================
         Menu Item
         ================================================================ -->
    <menuitem id="menu_loan_partial_payoff"
              name="Partial Payoffs"
              parent="menu_alba_repayments_root"
              action="action_loan_partial_payoff"
              sequence="15"
              groups="alba_loans.group_loan_user"/>

</odoo>