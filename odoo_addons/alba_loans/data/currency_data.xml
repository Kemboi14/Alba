<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ================================================================
             Default Currency Configuration
             KES (Kenyan Shilling) as default
             ================================================================ -->

        <record id="currency_config_kes" model="alba.currency.config">
            <field name="currency_id" ref="base.KES"/>
            <field name="is_default" eval="True"/>
            <field name="is_active" eval="True"/>
            <field name="use_manual_rate" eval="False"/>
            <field name="exchange_rate_manual">1.0</field>
        </record>

        <!-- USD Configuration -->
        <record id="currency_config_usd" model="alba.currency.config">
            <field name="currency_id" ref="base.USD"/>
            <field name="is_default" eval="False"/>
            <field name="is_active" eval="True"/>
            <field name="use_manual_rate" eval="False"/>
            <field name="exchange_rate_manual">130.0</field>
        </record>

        <!-- EUR Configuration -->
        <record id="currency_config_eur" model="alba.currency.config">
            <field name="currency_id" ref="base.EUR"/>
            <field name="is_default" eval="False"/>
            <field name="is_active" eval="True"/>
            <field name="use_manual_rate" eval="False"/>
            <field name="exchange_rate_manual">142.0</field>
        </record>

        <!-- GBP Configuration -->
        <record id="currency_config_gbp" model="alba.currency.config">
            <field name="currency_id" ref="base.GBP"/>
            <field name="is_default" eval="False"/>
            <field name="is_active" eval="True"/>
            <field name="use_manual_rate" eval="False"/>
            <field name="exchange_rate_manual">165.0</field>
        </record>

    </data>
</odoo>
