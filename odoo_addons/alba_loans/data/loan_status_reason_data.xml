<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- ==================== DEFERRED REASONS ==================== -->
        <record id="reason_deferred_insufficient_info" model="alba.loan.status.reason">
            <field name="name">Insufficient Information</field>
            <field name="code">DEF_001</field>
            <field name="category">deferred</field>
            <field name="sequence">10</field>
            <field name="description">Additional information required from applicant</field>
        </record>
        <record id="reason_deferred_insufficient_kyc" model="alba.loan.status.reason">
            <field name="name">Insufficient KYC</field>
            <field name="code">DEF_002</field>
            <field name="category">deferred</field>
            <field name="sequence">20</field>
            <field name="description">KYC documents incomplete or verification pending</field>
        </record>
        <record id="reason_deferred_pending_document" model="alba.loan.status.reason">
            <field name="name">Pending Document</field>
            <field name="code">DEF_003</field>
            <field name="category">deferred</field>
            <field name="sequence">30</field>
            <field name="description">Awaiting required supporting documents</field>
        </record>
        <record id="reason_deferred_pending_employer_verification" model="alba.loan.status.reason">
            <field name="name">Pending Employer Verification</field>
            <field name="code">DEF_004</field>
            <field name="category">deferred</field>
            <field name="sequence">40</field>
            <field name="description">Awaiting employer confirmation</field>
        </record>
        <record id="reason_deferred_pending_guarantor" model="alba.loan.status.reason">
            <field name="name">Pending Guarantor Confirmation</field>
            <field name="code">DEF_005</field>
            <field name="category">deferred</field>
            <field name="sequence">50</field>
            <field name="description">Awaiting guarantor consent or confirmation</field>
        </record>
        <record id="reason_deferred_further_assessment" model="alba.loan.status.reason">
            <field name="name">Further Assessment Required</field>
            <field name="code">DEF_006</field>
            <field name="category">deferred</field>
            <field name="sequence">60</field>
            <field name="description">Additional credit analysis or risk assessment needed</field>
        </record>

        <!-- ==================== DECLINED REASONS ==================== -->
        <record id="reason_declined_low_credit_score" model="alba.loan.status.reason">
            <field name="name">Low Credit Score</field>
            <field name="code">DCL_001</field>
            <field name="category">declined</field>
            <field name="sequence">10</field>
            <field name="description">Credit score below minimum threshold</field>
        </record>
        <record id="reason_declined_high_debt_ratio" model="alba.loan.status.reason">
            <field name="name">High Debt-to-Income Ratio</field>
            <field name="code">DCL_002</field>
            <field name="category">declined</field>
            <field name="sequence">20</field>
            <field name="description">Existing obligations exceed acceptable limits</field>
        </record>
        <record id="reason_declined_insufficient_income" model="alba.loan.status.reason">
            <field name="name">Insufficient Income</field>
            <field name="code">DCL_003</field>
            <field name="category">declined</field>
            <field name="sequence">30</field>
            <field name="description">Income does not meet loan repayment requirements</field>
        </record>
        <record id="reason_declined_blacklisted" model="alba.loan.status.reason">
            <field name="name">Customer Blacklisted</field>
            <field name="code">DCL_004</field>
            <field name="category">declined</field>
            <field name="sequence">40</field>
            <field name="description">Customer on Alba blacklist or negative list</field>
        </record>
        <record id="reason_declined_poor_kyc" model="alba.loan.status.reason">
            <field name="name">Poor KYC Verification</field>
            <field name="code">DCL_005</field>
            <field name="category">declined</field>
            <field name="sequence">50</field>
            <field name="description">KYC verification failed or identity concerns</field>
        </record>
        <record id="reason_declined_employment_issue" model="alba.loan.status.reason">
            <field name="name">Employment Verification Failed</field>
            <field name="code">DCL_006</field>
            <field name="category">declined</field>
            <field name="sequence">60</field>
            <field name="description">Employer verification failed or employment unconfirmed</field>
        </record>
        <record id="reason_declined_incomplete_application" model="alba.loan.status.reason">
            <field name="name">Incomplete Application</field>
            <field name="code">DCL_007</field>
            <field name="category">declined</field>
            <field name="sequence">70</field>
            <field name="description">Application cannot be completed despite follow-up</field>
        </record>
        <record id="reason_declined_policy_violation" model="alba.loan.status.reason">
            <field name="name">Policy Violation</field>
            <field name="code">DCL_008</field>
            <field name="category">declined</field>
            <field name="sequence">80</field>
            <field name="description">Application violates Alba lending policy</field>
        </record>
        <record id="reason_declined_fraud_risk" model="alba.loan.status.reason">
            <field name="name">Fraud Risk</field>
            <field name="code">DCL_009</field>
            <field name="category">declined</field>
            <field name="sequence">90</field>
            <field name="description">Application shows signs of fraud or misrepresentation</field>
        </record>
    </data>
</odoo>
