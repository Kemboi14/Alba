<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Loan Processing Fee Product -->
        <record id="fee_product_loan_processing" model="product.product">
            <field name="name">Loan Processing Fee</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description">Service product for loan processing fees.</field>
        </record>

        <!-- Loan Insurance Fee Product -->
        <record id="fee_product_loan_insurance" model="product.product">
            <field name="name">Loan Insurance Fee</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description">Service product for loan insurance fees (Credit Life).</field>
        </record>

        <!-- Loan Origination Fee Product -->
        <record id="fee_product_loan_origination" model="product.product">
            <field name="name">Loan Origination Fee</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description">Service product for loan origination / setup fees.</field>
        </record>
    </data>
</odoo>
