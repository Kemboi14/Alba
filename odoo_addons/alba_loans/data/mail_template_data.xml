<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Employer Verification Email ────────────────────────── -->
        <record id="email_template_employer_verification" model="mail.template">
            <field name="name">Loan Application: Employer Verification</field>
            <field name="model_id" ref="alba_loans.model_alba_loan_application"/>
            <field name="subject">Employment Verification Request - {{ object.customer_id.display_name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.customer_id.employer_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.customer_id.employer_id.name"/>,<br/><br/>
                        We have received a loan application from your employee,
                        <strong t-out="object.customer_id.display_name"/>,
                        who has listed your organization as their current employer.<br/><br/>
                        Please confirm the following details for our credit assessment:<br/>
                        - Job Title: <t t-out="object.customer_id.job_title">N/A</t><br/>
                        - Monthly Net Income: <t t-out="object.currency_id.symbol"/> <t t-out="object.customer_id.monthly_income">0.00</t><br/><br/>
                        You can reply to this email to confirm or provide further details.<br/><br/>
                        Thank you,<br/>
                        The Credit Team<br/>
                        <strong t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Guarantor Confirmation Email ────────────────────────── -->
        <record id="email_template_guarantor_confirmation" model="mail.template">
            <field name="name">Loan Application: Guarantor Confirmation</field>
            <field name="model_id" ref="alba_loans.model_alba_loan_guarantor"/>
            <field name="subject">Guarantor Confirmation Request - {{ object.customer_id.display_name }}</field>
            <field name="email_from">{{ (object.loan_application_id.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.guarantor_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.guarantor_id.name"/>,<br/><br/>
                        You have been listed as a guarantor for a loan application by
                        <strong t-out="object.customer_id.display_name"/>
                        for the amount of
                        <strong><t t-out="object.currency_id.symbol"/> <t t-out="object.guarantee_amount"/></strong>.<br/><br/>
                        Please confirm your willingness to act as a guarantor for this loan.<br/><br/>
                        Your confirmation code is:
                        <strong style="font-size: 18px; color: #004a99;" t-out="object.confirmation_code"/><br/><br/>
                        Thank you,<br/>
                        <strong t-out="object.loan_application_id.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Application Submitted ────────────────────────────── -->
        <record id="email_template_application_submitted" model="mail.template">
            <field name="name">Loan Application: Submitted</field>
            <field name="model_id" ref="alba_loans.model_alba_loan_application"/>
            <field name="subject">Loan Application Submitted - {{ object.application_number }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.customer_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.customer_id.display_name"/>,<br/><br/>
                        Your loan application <strong t-out="object.application_number"/> has been successfully
                        submitted and is now under review by our credit team.<br/><br/>
                        <strong>Application Details:</strong><br/>
                        - Product: <t t-out="object.loan_product_id.name"/><br/>
                        - Amount: <t t-out="object.currency_id.symbol"/> <t t-out="object.requested_amount"/><br/>
                        - Tenure: <t t-out="object.tenure_months"/> Months<br/><br/>
                        We will notify you once the review is complete.<br/><br/>
                        Thank you,<br/>
                        <strong t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Application Approved ────────────────────────────── -->
        <record id="email_template_application_approved" model="mail.template">
            <field name="name">Loan Application: Approved</field>
            <field name="model_id" ref="alba_loans.model_alba_loan_application"/>
            <field name="subject">Loan Application Approved - {{ object.application_number }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.customer_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.customer_id.display_name"/>,<br/><br/>
                        Great news! Your loan application <strong t-out="object.application_number"/> has been
                        <strong>APPROVED</strong> for the amount of
                        <strong><t t-out="object.currency_id.symbol"/> <t t-out="object.approved_amount"/></strong>.<br/><br/>
                        Our team will contact you shortly regarding the next steps for disbursement.<br/><br/>
                        Thank you,<br/>
                        <strong t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Application Rejected ────────────────────────────── -->
        <record id="email_template_application_rejected" model="mail.template">
            <field name="name">Loan Application: Rejected</field>
            <field name="model_id" ref="alba_loans.model_alba_loan_application"/>
            <field name="subject">Update on your Loan Application - {{ object.application_number }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.customer_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.customer_id.display_name"/>,<br/><br/>
                        We regret to inform you that your loan application
                        <strong t-out="object.application_number"/>
                        has not been approved at this time.<br/><br/>
                        <t t-if="object.rejection_reason">
                        <strong>Reason:</strong> <t t-out="object.rejection_reason"/><br/><br/>
                        </t>
                        Thank you for considering us for your financial needs.<br/><br/>
                        Best regards,<br/>
                        <strong t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Loan Disbursed ─────────────────────────────────── -->
        <record id="email_template_loan_disbursed" model="mail.template">
            <field name="name">Loan Application: Disbursed</field>
            <field name="model_id" ref="alba_loans.model_alba_loan_application"/>
            <field name="subject">Loan Disbursed - {{ object.application_number }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.customer_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.customer_id.display_name"/>,<br/><br/>
                        Your loan <strong t-out="object.application_number"/> has been
                        <strong>DISBURSED</strong>. The funds should be available in your account shortly.<br/><br/>
                        Your first repayment is due on
                        <t t-out="object.loan_id.next_payment_due_date">the scheduled date</t>.<br/><br/>
                        Thank you,<br/>
                        <strong t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Loan Top-Up ─────────────────────────────────── -->
        <record id="email_template_loan_topup" model="mail.template">
            <field name="name">Loan: Top-Up Disbursed</field>
            <field name="model_id" ref="alba_loans.model_alba_loan_topup"/>
            <field name="subject">Loan Top-Up Disbursed - {{ object.name }}</field>
            <field name="email_from">{{ (object.loan_id.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.partner_id.name"/>,<br/><br/>
                        Your loan top-up request <strong t-out="object.name"/> has been disbursed.<br/><br/>
                        <strong>Details:</strong><br/>
                        - Top-Up Amount: <t t-out="object.currency_id.symbol"/> <t t-out="object.topup_amount"/><br/>
                        - New Principal: <t t-out="object.currency_id.symbol"/> <t t-out="object.new_principal"/><br/><br/>
                        Thank you for choosing us.<br/><br/>
                        Best regards,<br/>
                        <strong t-out="object.loan_id.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Partial Payoff ─────────────────────────────────── -->
        <record id="email_template_partial_payoff" model="mail.template">
            <field name="name">Loan: Partial Payoff Applied</field>
            <field name="model_id" ref="alba_loans.model_alba_loan_partial_payoff"/>
            <field name="subject">Partial Payoff Applied - {{ object.name }}</field>
            <field name="email_from">{{ (object.loan_id.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.partner_id.name"/>,<br/><br/>
                        We have successfully applied your partial payoff of
                        <strong><t t-out="object.currency_id.symbol"/> <t t-out="object.payoff_amount"/></strong>
                        to your loan.<br/><br/>
                        <strong>Impact:</strong><br/>
                        - Interest Saved: <t t-out="object.currency_id.symbol"/> <t t-out="object.interest_saved"/><br/>
                        - New Outstanding: <t t-out="object.currency_id.symbol"/> <t t-out="object.new_outstanding"/><br/>
                        <t t-if="object.reduction_mode == 'reduce_emi'">
                        - New EMI: <t t-out="object.currency_id.symbol"/> <t t-out="object.new_emi"/><br/>
                        </t>
                        <t t-else="">
                        - New Tenure: <t t-out="object.new_tenure"/> months<br/>
                        </t>
                        <br/>
                        Thank you for your timely payment.<br/><br/>
                        Best regards,<br/>
                        <strong t-out="object.loan_id.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Payment Holiday ─────────────────────────────────── -->
        <record id="email_template_payment_holiday" model="mail.template">
            <field name="name">Loan: Payment Holiday Activated</field>
            <field name="model_id" ref="alba_loans.model_alba_loan_payment_holiday"/>
            <field name="subject">Payment Holiday Activated - {{ object.name }}</field>
            <field name="email_from">{{ (object.loan_id.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.partner_id.name"/>,<br/><br/>
                        Your payment holiday request has been <strong>ACTIVATED</strong>.<br/><br/>
                        <strong>Period:</strong><br/>
                        - Start Date: <t t-out="object.start_date"/><br/>
                        - End Date: <t t-out="object.end_date"/><br/>
                        - Duration: <t t-out="object.holiday_months"/> Months<br/><br/>
                        Your repayments will resume after the holiday period ends.<br/><br/>
                        Best regards,<br/>
                        <strong t-out="object.loan_id.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Refinance ─────────────────────────────────── -->
        <record id="email_template_refinance" model="mail.template">
            <field name="name">Loan: Refinance Completed</field>
            <field name="model_id" ref="alba_loans.model_alba_loan_refinance"/>
            <field name="subject">Loan Refinance Completed - {{ object.name }}</field>
            <field name="email_from">{{ (object.original_loan_id.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.partner_id.name"/>,<br/><br/>
                        Your loan refinance process is now <strong>COMPLETE</strong>.<br/><br/>
                        <strong>Summary:</strong><br/>
                        - Old Loan: <t t-out="object.original_loan_id.loan_number"/> (Settled)<br/>
                        - New Loan: <t t-out="object.new_loan_id.loan_number"/> (Active)<br/>
                        - New Principal: <t t-out="object.currency_id.symbol"/> <t t-out="object.new_principal"/><br/>
                        - Monthly Savings: <t t-out="object.currency_id.symbol"/> <t t-out="object.monthly_savings"/><br/><br/>
                        Thank you for your continued trust in us.<br/><br/>
                        Best regards,<br/>
                        <strong t-out="object.original_loan_id.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Consolidation ─────────────────────────────────── -->
        <!-- FIX: 'object.customer_id.company_id' is res.partner.company_id (another partner),
             not res.company — it does not have email_formatted. Changed to object.new_loan_id.company_id -->
        <record id="email_template_consolidation" model="mail.template">
            <field name="name">Loan: Consolidation Completed</field>
            <field name="model_id" ref="alba_loans.model_alba_loan_consolidation"/>
            <field name="subject">Loan Consolidation Completed - {{ object.name }}</field>
            <field name="email_from">{{ (object.new_loan_id.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.partner_id.name"/>,<br/><br/>
                        We have successfully consolidated your loans into a single account.<br/><br/>
                        <strong>Summary:</strong><br/>
                        - Loans Merged: <t t-out="object.loan_count"/><br/>
                        - New Loan Account: <t t-out="object.new_loan_id.loan_number"/><br/>
                        - New Monthly EMI: <t t-out="object.currency_id.symbol"/> <t t-out="object.new_emi"/><br/>
                        - Monthly Savings: <t t-out="object.currency_id.symbol"/> <t t-out="object.monthly_savings"/><br/><br/>
                        Please refer to the attached schedule for your new repayment plan.<br/><br/>
                        Best regards,<br/>
                        <strong t-out="object.new_loan_id.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Loan Closed / Fully Repaid ──────────────────────────── -->
        <record id="email_template_loan_closed" model="mail.template">
            <field name="name">Loan: Fully Repaid / Closed</field>
            <field name="model_id" ref="alba_loans.model_alba_loan"/>
            <field name="subject">Congratulations! Loan {{ object.loan_number }} Fully Repaid</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.customer_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.customer_id.display_name"/>,<br/><br/>
                        Congratulations! Your loan <strong t-out="object.loan_number"/> has been
                        <strong>FULLY REPAID</strong> and is now closed.<br/><br/>
                        <strong>Summary:</strong><br/>
                        - Loan Number: <t t-out="object.loan_number"/><br/>
                        - Total Repaid: <t t-out="object.currency_id.symbol"/> <t t-out="object.total_paid"/><br/>
                        - Closed On: <t t-out="object.write_date.strftime('%d %B %Y')"/><br/><br/>
                        Thank you for your commitment to repaying your loan on time.
                        We look forward to serving you again.<br/><br/>
                        Best regards,<br/>
                        <strong t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Loan NPL Flagged ─────────────────────────────────── -->
        <record id="email_template_loan_npl" model="mail.template">
            <field name="name">Loan: Non-Performing (NPL) Notice</field>
            <field name="model_id" ref="alba_loans.model_alba_loan"/>
            <field name="subject">Important: Action Required — Loan {{ object.loan_number }} in Arrears</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.customer_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.customer_id.display_name"/>,<br/><br/>
                        This is an urgent notice regarding your loan
                        <strong t-out="object.loan_number"/>.<br/><br/>
                        Your loan is currently
                        <strong><t t-out="object.days_in_arrears"/> days overdue</strong> with an
                        outstanding arrears amount of
                        <strong><t t-out="object.currency_id.symbol"/> <t t-out="object.arrears_amount"/></strong>.<br/><br/>
                        <strong>Immediate action is required</strong> to avoid further penalties
                        and legal proceedings.<br/><br/>
                        Please contact us immediately:<br/>
                        - Outstanding Balance: <t t-out="object.currency_id.symbol"/> <t t-out="object.outstanding_balance"/><br/>
                        - Days Overdue: <t t-out="object.days_in_arrears"/><br/><br/>
                        Failure to respond may result in legal action and credit bureau reporting.<br/><br/>
                        Regards,<br/>
                        <strong><t t-out="object.company_id.name"/> — Collections Team</strong>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Repayment Receipt ──────────────────────────────── -->
        <record id="email_template_repayment_receipt" model="mail.template">
            <field name="name">Loan: Repayment Receipt</field>
            <field name="model_id" ref="alba_loans.model_alba_loan_repayment"/>
            <field name="subject">Payment Receipt — {{ object.loan_id.loan_number }} — Ref: {{ object.payment_reference }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.customer_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.customer_id.display_name"/>,<br/><br/>
                        We have received your payment of
                        <strong><t t-out="object.currency_id.symbol"/> <t t-out="object.amount_paid"/></strong>
                        towards loan <strong t-out="object.loan_id.loan_number"/>.<br/><br/>
                        <strong>Payment Details:</strong><br/>
                        - Reference: <t t-out="object.payment_reference"/><br/>
                        - Date: <t t-out="object.payment_date"/><br/>
                        - Principal: <t t-out="object.currency_id.symbol"/> <t t-out="object.principal_component"/><br/>
                        - Interest: <t t-out="object.currency_id.symbol"/> <t t-out="object.interest_component"/><br/>
                        - Outstanding Balance: <t t-out="object.currency_id.symbol"/> <t t-out="object.loan_id.outstanding_balance"/><br/><br/>
                        Thank you for your payment.<br/><br/>
                        Best regards,<br/>
                        <strong t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>
