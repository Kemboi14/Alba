<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="alba_investors.InvestorStatement">
        <div class="o_action o_view_controller bg-view p-4 overflow-auto h-100 style_investor_stmt">
            <!-- Filter / Control Bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 p-3 bg-light rounded border shadow-sm gap-3">
                <div class="d-flex align-items-center gap-3">
                    <h3 class="m-0 text-primary fw-bold">
                        <i class="fa fa-file-text-o me-2"/>Investor Statement
                    </h3>
                    <t t-if="state.data and state.data.customer_name">
                        <span class="badge bg-secondary fs-6">
                            <t t-esc="state.data.customer_name"/>
                        </span>
                    </t>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <label class="fw-bold mb-0 text-muted small">From:</label>
                        <input type="date" class="form-control form-control-sm" t-model="state.dateFrom"/>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="fw-bold mb-0 text-muted small">To:</label>
                        <input type="date" class="form-control form-control-sm" t-model="state.dateTo"/>
                    </div>
                    <button class="btn btn-sm btn-primary d-flex align-items-center gap-1" t-on-click="onRefresh" t-att-disabled="state.loading">
                        <i class="fa fa-refresh" t-att-class="{'fa-spin': state.loading}"/> Refresh
                    </button>
                    <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1" t-on-click="onDownloadPdf">
                        <i class="fa fa-file-pdf-o"/> Download PDF
                    </button>
                </div>
            </div>

            <!-- Loading Spinner -->
            <t t-if="state.loading">
                <div class="text-center my-5 py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted mt-2">Generating statement view...</p>
                </div>
            </t>

            <!-- Error Banner -->
            <t t-elif="state.error">
                <div class="alert alert-danger" role="alert">
                    <i class="fa fa-exclamation-circle me-2"/><t t-esc="state.error"/>
                </div>
            </t>

            <!-- Main Statement Display -->
            <t t-elif="state.data">
                <!-- Customer & Account Info Card -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="card h-100 border-primary">
                            <div class="card-header bg-primary text-white fw-bold">Customer Details</div>
                            <div class="card-body">
                                <p class="mb-1"><strong>Name:</strong> <t t-esc="state.data.customer_name"/></p>
                                <p class="mb-0"><strong>Address:</strong> <t t-esc="state.data.customer_address or '—'"/></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 border-primary">
                            <div class="card-header bg-primary text-white fw-bold">Account Overview</div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-6 mb-2"><strong>Account No:</strong> <t t-esc="state.data.account_number"/></div>
                                    <div class="col-6 mb-2"><strong>Product:</strong> <t t-esc="state.data.product_name"/></div>
                                    <div class="col-6"><strong>Period:</strong> <t t-esc="state.data.date_from"/> to <t t-esc="state.data.date_to"/></div>
                                    <div class="col-6"><strong>Statement Date:</strong> <t t-esc="state.data.statement_date"/></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Financial Summary Box -->
                <div class="card mb-4 border-info shadow-sm">
                    <div class="card-header bg-info text-white fw-bold">Financial Summary</div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered text-center m-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Opening Balance</th>
                                        <th>Deposits / Top-Ups</th>
                                        <th>Withdrawals</th>
                                        <th>Total Interest Accrued</th>
                                        <th>Closing Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="fw-semibold text-primary"><t t-esc="state.data.opening_balance_fmt"/></td>
                                        <td class="fw-semibold text-success"><t t-esc="state.data.deposits_fmt"/></td>
                                        <td class="fw-semibold text-danger"><t t-esc="state.data.withdrawals_fmt"/></td>
                                        <td class="fw-semibold text-info"><t t-esc="state.data.interest_accrued_fmt"/></td>
                                        <td class="fw-bold text-dark fs-6"><t t-esc="state.data.closing_balance_fmt"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Interest Settlement Sub-table -->
                        <div class="bg-light p-2 border-top fw-bold text-uppercase small text-muted">
                            Interest Settlement Summary
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered text-center m-0">
                                <thead>
                                    <tr class="table-secondary small">
                                        <th>Gross Interest Paid</th>
                                        <th>WHT Deducted (<t t-esc="state.data.wht_rate"/>%)</th>
                                        <th>Net Interest Paid</th>
                                        <th>Interest Outstanding</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="fw-semibold"><t t-esc="state.data.total_gross_paid_fmt"/></td>
                                        <td class="fw-semibold text-danger"><t t-esc="state.data.total_wht_deducted_fmt"/></td>
                                        <td class="fw-semibold text-success"><t t-esc="state.data.total_net_paid_fmt"/></td>
                                        <td class="fw-bold text-warning"><t t-esc="state.data.interest_outstanding_fmt"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Main Transaction Ledger Table -->
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold">Transaction Ledger</div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover m-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 110px;">Date</th>
                                        <th style="width: 100px;">Type</th>
                                        <th>Description</th>
                                        <th class="text-end" style="width: 130px;">Debits</th>
                                        <th class="text-end" style="width: 130px;">Credits</th>
                                        <th class="text-end" style="width: 150px;">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.lines" t-as="line" t-key="line_index">
                                        <tr>
                                            <td class="fw-semibold text-nowrap"><t t-esc="line.date"/></td>
                                            <td>
                                                <t t-if="line.type == 'deposit'"><span class="badge bg-success">Deposit</span></t>
                                                <t t-elif="line.type == 'topup'"><span class="badge bg-success">Top-Up</span></t>
                                                <t t-elif="line.type == 'accrual'"><span class="badge bg-primary">Accrual</span></t>
                                                <t t-elif="line.type == 'payout'"><span class="badge bg-warning text-dark">Payout</span></t>
                                                <t t-elif="line.type == 'withdrawal'"><span class="badge bg-danger">Withdrawal</span></t>
                                                <t t-else=""><span class="badge bg-secondary"><t t-esc="line.type_label or 'Opening'"/></span></t>
                                            </td>
                                            <td><t t-esc="line.description"/></td>
                                            <td class="text-end text-danger fw-semibold"><t t-esc="line.debit_fmt"/></td>
                                            <td class="text-end text-success fw-semibold"><t t-esc="line.credit_fmt"/></td>
                                            <td class="text-end fw-bold text-primary"><t t-esc="line.balance_fmt"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot class="table-light fw-bold">
                                    <tr>
                                        <td colspan="3" class="text-center">Totals</td>
                                        <td class="text-end text-danger"><t t-esc="state.data.total_debit_fmt"/></td>
                                        <td class="text-end text-success"><t t-esc="state.data.total_credit_fmt"/></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Collapsible / Supplementary Detail Tables -->
                <t t-if="state.data.topup_lines and state.data.topup_lines.length">
                    <div class="card mb-4 shadow-sm">
                        <div class="card-header bg-secondary text-white fw-bold">Deposits &amp; Top-Ups Detail</div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-striped m-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Reference</th>
                                        <th class="text-end">Amount</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.topup_lines" t-as="t" t-key="t_index">
                                        <tr>
                                            <td><t t-esc="t.date"/></td>
                                            <td><t t-esc="t.reference"/></td>
                                            <td class="text-end text-success fw-semibold"><t t-esc="t.amount_fmt"/></td>
                                            <td class="text-center"><t t-esc="t.status"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>

                <t t-if="state.data.accrual_lines and state.data.accrual_lines.length">
                    <div class="card mb-4 shadow-sm">
                        <div class="card-header bg-secondary text-white fw-bold">Interest Accrual History</div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-striped m-0">
                                <thead>
                                    <tr>
                                        <th>Accrual Date</th>
                                        <th>Period Start</th>
                                        <th>Period End</th>
                                        <th class="text-end">Opening Balance</th>
                                        <th class="text-end">Interest Amount</th>
                                        <th class="text-end">Closing Balance</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.accrual_lines" t-as="a" t-key="a_index">
                                        <tr>
                                            <td><t t-esc="a.accrual_date"/></td>
                                            <td><t t-esc="a.period_start"/></td>
                                            <td><t t-esc="a.period_end"/></td>
                                            <td class="text-end"><t t-esc="a.opening_balance_fmt"/></td>
                                            <td class="text-end text-primary fw-semibold"><t t-esc="a.interest_amount_fmt"/></td>
                                            <td class="text-end"><t t-esc="a.closing_balance_fmt"/></td>
                                            <td class="text-center">
                                                <span t-att-class="a.status_class == 'paid' ? 'badge bg-success' : 'badge bg-warning text-dark'">
                                                    <t t-esc="a.status"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>

                <t t-if="state.data.payout_lines and state.data.payout_lines.length">
                    <div class="card mb-4 shadow-sm">
                        <div class="card-header bg-secondary text-white fw-bold">Interest Payout Records</div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-striped m-0">
                                <thead>
                                    <tr>
                                        <th>Payout Date</th>
                                        <th>Reference</th>
                                        <th>Accruals Covered</th>
                                        <th class="text-end">Gross Interest</th>
                                        <th class="text-end">WHT Deducted</th>
                                        <th class="text-end">Net Paid</th>
                                        <th>Payment Ref</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.payout_lines" t-as="p" t-key="p_index">
                                        <tr>
                                            <td><t t-esc="p.payout_date"/></td>
                                            <td><t t-esc="p.reference"/></td>
                                            <td><t t-esc="p.accrual_range"/></td>
                                            <td class="text-end"><t t-esc="p.gross_interest_fmt"/></td>
                                            <td class="text-end text-danger"><t t-esc="p.wht_deducted_fmt"/></td>
                                            <td class="text-end text-success fw-semibold"><t t-esc="p.net_paid_fmt"/></td>
                                            <td><t t-esc="p.payment_ref"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>

                <t t-if="state.data.withdrawal_lines and state.data.withdrawal_lines.length">
                    <div class="card mb-4 shadow-sm">
                        <div class="card-header bg-secondary text-white fw-bold">Investment Withdrawal Records</div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-striped m-0">
                                <thead>
                                    <tr>
                                        <th>Withdrawal Date</th>
                                        <th>Payment Reference</th>
                                        <th class="text-end">Principal</th>
                                        <th class="text-end">Top-Ups</th>
                                        <th class="text-end">Accrued Interest</th>
                                        <th class="text-end">Total Paid Out</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.withdrawal_lines" t-as="w" t-key="w_index">
                                        <tr>
                                            <td><t t-esc="w.date"/></td>
                                            <td><t t-esc="w.reference"/></td>
                                            <td class="text-end"><t t-esc="w.principal_fmt"/></td>
                                            <td class="text-end"><t t-esc="w.topups_fmt"/></td>
                                            <td class="text-end text-primary"><t t-esc="w.interest_fmt"/></td>
                                            <td class="text-end text-danger fw-bold"><t t-esc="w.gross_fmt"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </div>
    </t>
</templates>
