<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ================================================================
             Alba Investors — Scheduled Actions (Cron Jobs)
             ================================================================ -->

        <!-- ── 1. Daily Interest Accrual Check ────────────────────────── -->
        <!-- Runs daily to check if compound interest accrual should run
             for any investment products based on their configuration. -->
        <record id="ir_cron_alba_monthly_interest_accrual" model="ir.cron">
            <field name="name">Alba: Automated Interest Accrual Check (Daily)</field>
            <field name="model_id" ref="alba_investors.model_alba_investment"/>
            <field name="state">code</field>
            <field name="code">model.action_run_automated_interest_accrual()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="priority">5</field>
        </record>

        <!-- ── 2. Daily Statement Generation Check ────────────────────── -->
        <!-- Runs daily to generate and send monthly statements for investments
             whose product settings match the statement run date. -->
        <record id="ir_cron_alba_monthly_statement_generation" model="ir.cron">
            <field name="name">Alba: Automated Statement Generation Check (Daily)</field>
            <field name="model_id" ref="alba_investors.model_alba_investment_statement"/>
            <field name="state">code</field>
            <field name="code">model.action_run_automated_statement_generation()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="priority">10</field>
        </record>

        <!-- ── 3. Investment Maturity Reminder ────────────────────────── -->
        <!-- Runs daily to find investments maturing in 7 days and notify. -->
        <record id="ir_cron_alba_investment_maturity_reminder" model="ir.cron">
            <field name="name">Alba: Investment Maturity Reminder (7 Days)</field>
            <field name="model_id" ref="alba_investors.model_alba_investment"/>
            <field name="state">code</field>
            <field name="code">model.action_check_maturing_investments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="priority">20</field>
        </record>

        <!-- ── 4. Purge Preview-Only Statements ───────────────────────── -->
        <!-- Deletes draft statements created purely to render a one-off PDF
             preview (Investor form > Preview Statement, "PDF (Download)"),
             once they're a day old — long after the PDF has been rendered. -->
        <record id="ir_cron_alba_purge_preview_statements" model="ir.cron">
            <field name="name">Alba: Purge Preview-Only Statements (Daily)</field>
            <field name="model_id" ref="alba_investors.model_alba_investment_statement"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_preview_statements()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="priority">30</field>
        </record>

    </data>
</odoo>
