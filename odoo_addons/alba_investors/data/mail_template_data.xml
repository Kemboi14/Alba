<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Investment Activated ────────────────────────────── -->
        <record id="email_template_investment_active" model="mail.template">
            <field name="name">Investment: Activated</field>
            <field name="model_id" ref="alba_investors.model_alba_investment"/>
            <field name="subject">Investment Account Activated - {{ object.investment_number }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.investor_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.investor_id.investor_name"/>,<br/><br/>
                        Your investment account <strong t-out="object.investment_number"/> has been successfully activated.<br/><br/>
                        <strong>Investment Details:</strong><br/>
                        - Principal Amount: <t t-out="object.currency_id.symbol"/> <t t-out="object.principal_amount"/><br/>
                        - Interest Rate: <t t-out="object.interest_rate"/>% per annum<br/>
                        - Compounding: <t t-out="object.compounding_frequency"/><br/>
                        - Start Date: <t t-out="object.start_date"/><br/><br/>
                        Thank you for investing with us.<br/><br/>
                        Best regards,<br/>
                        <strong t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Interest Accrued ────────────────────────────────── -->
        <record id="email_template_interest_accrued" model="mail.template">
            <field name="name">Investment: Interest Accrued</field>
            <field name="model_id" ref="alba_investors.model_alba_interest_accrual"/>
            <field name="subject">Interest Credited to {{ object.investment_id.investment_number }}</field>
            <field name="email_from">{{ (object.investment_id.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.investment_id.investor_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.investment_id.investor_id.investor_name"/>,<br/><br/>
                        Interest has been credited to your investment account <strong t-out="object.investment_id.investment_number"/>.<br/><br/>
                        <strong>Accrual Details:</strong><br/>
                        - Amount: <t t-out="object.currency_id.symbol"/> <t t-out="object.interest_amount"/><br/>
                        - Period: <t t-out="object.period_start"/> to <t t-out="object.period_end"/><br/>
                        - New Portfolio Value: <t t-out="object.currency_id.symbol"/> <t t-out="object.investment_id.current_value"/><br/><br/>
                        Thank you for your continued partnership.<br/><br/>
                        Best regards,<br/>
                        <strong t-out="object.investment_id.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <!-- ── Investment Statement ───────────────────────────── -->
        <record id="email_template_investment_statement" model="mail.template">
            <field name="name">Investment: Statement Sent</field>
            <field name="model_id" ref="alba_investors.model_alba_investment_statement"/>
            <field name="subject">Investment Statement - {{ object.reference }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <strong t-out="object.investor_id.investor_name"/>,<br/><br/>
                        Please find below your investment statement for the period <strong t-out="object.period_start"/> to <strong t-out="object.period_end"/>.<br/><br/>
                        <strong>Summary:</strong><br/>
                        - Opening Balance: <t t-out="object.currency_id.symbol"/> <t t-out="object.opening_balance"/><br/>
                        - Interest Accrued: <t t-out="object.currency_id.symbol"/> <t t-out="object.interest_accrued"/><br/>
                        - Deposits: <t t-out="object.currency_id.symbol"/> <t t-out="object.deposits"/><br/>
                        - Withdrawals: <t t-out="object.currency_id.symbol"/> <t t-out="object.withdrawals"/><br/>
                        - Closing Balance: <t t-out="object.currency_id.symbol"/> <t t-out="object.closing_balance"/><br/><br/>
                        The full details are available on your online portal.<br/><br/>
                        Thank you,<br/>
                        <strong t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>
