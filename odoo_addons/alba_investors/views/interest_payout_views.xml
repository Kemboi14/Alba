<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- ================================================================
         alba.interest.payout — List View
         ================================================================ -->
    <record id="view_alba_interest_payout_list" model="ir.ui.view">
        <field name="name">alba.interest.payout.list</field>
        <field name="model">alba.interest.payout</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Interest Payouts"
                  decoration-success="state == 'posted'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="investment_id"/>
                <field name="investor_id"/>
                <field name="payout_date"/>
                <field name="currency_id" optional="hide"/>
                <field name="gross_interest" widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       sum="Total Gross"/>
                <field name="wht_amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       sum="Total WHT"/>
                <field name="net_amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       sum="Total Net"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         alba.interest.payout — Form View
         ================================================================ -->
    <record id="view_alba_interest_payout_form" model="ir.ui.view">
        <field name="name">alba.interest.payout.form</field>
        <field name="model">alba.interest.payout</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Interest Payout">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>
                <sheet>

                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_view_payment"
                                class="oe_stat_button"
                                icon="fa-credit-card"
                                invisible="not payment_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Payment</span>
                            </div>
                        </button>
                        <button type="object"
                                name="action_view_wht_entry"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="not wht_move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">WHT Entry</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Interest Payout"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Investment Details">
                            <field name="investment_id" readonly="1"
                                   options="{'no_create': True, 'no_open': False}"/>
                            <field name="investor_id" readonly="1"/>
                            <field name="payout_date" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group string="Payout Breakdown">
                            <field name="gross_interest" widget="monetary" readonly="1"/>
                            <field name="wht_amount" widget="monetary" readonly="1"
                                   class="text-danger"/>
                            <field name="net_amount" widget="monetary" readonly="1"
                                   class="h4 fw-bold text-success"/>
                        </group>
                    </group>

                    <group string="Journal Entries" groups="account.group_account_user">
                        <group>
                            <field name="payment_id" readonly="1"
                                   invisible="not payment_id"/>
                        </group>
                        <group>
                            <field name="wht_move_id" readonly="1"
                                   invisible="not wht_move_id"/>
                        </group>
                    </group>

                    <!-- Accruals cleared -->
                    <notebook>
                        <page string="Accruals Cleared" name="accruals">
                            <field name="accrual_ids" readonly="1">
                                <list string="Accruals">
                                    <field name="accrual_date"/>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="opening_balance" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="interest_amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           sum="Total"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'paid'"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"
                                   placeholder="Internal notes…"/>
                        </page>
                    </notebook>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================
         alba.interest.payout — Search View
         ================================================================ -->
    <record id="view_alba_interest_payout_search" model="ir.ui.view">
        <field name="name">alba.interest.payout.search</field>
        <field name="model">alba.interest.payout</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Interest Payouts">
                <field name="name"/>
                <field name="investment_id"/>
                <field name="investor_id"/>
                <field name="payout_date"/>
                <separator/>
                <filter name="posted" string="Posted"
                        domain="[('state', '=', 'posted')]"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="this_month" string="This Month"
                        domain="[('payout_date', '&gt;=', (context_today()).replace(day=1)),
                                  ('payout_date', '&lt;=', (context_today() + relativedelta(months=1, day=1)) - relativedelta(days=1))]"/>
                <group>
                    <filter name="group_investor" string="Investor"
                            context="{'group_by': 'investor_id'}"/>
                    <filter name="group_investment" string="Investment"
                            context="{'group_by': 'investment_id'}"/>
                    <filter name="group_month" string="Month"
                            context="{'group_by': 'payout_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         alba.interest.payout — Action Window
         ================================================================ -->
    <record id="action_alba_interest_payout" model="ir.actions.act_window">
        <field name="name">Interest Payouts</field>
        <field name="res_model">alba.interest.payout</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No interest payouts yet
            </p>
            <p>
                Interest payouts are created when you click <b>Pay Accrued Interest</b>
                on an active investment. The principal stays intact and the investment
                continues running.
            </p>
        </field>
    </record>

</data>
</odoo>
