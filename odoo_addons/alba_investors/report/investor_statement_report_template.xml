<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shared account statement layout (bank-style PDF) -->
    <template id="account_statement_document">
        <!-- Set company BEFORE calling basic_layout for proper scoping -->
        <t t-set="company" t-value="res_company or company or (docs and docs[0].company_id) or (o and o.company_id) or env.company"/>
        <t t-call="web.basic_layout">

            <!-- Custom Header -->
            <div class="header" style="font-family: 'Source Sans 3', 'Helvetica Neue', Helvetica, Arial, sans-serif; padding-bottom: 8px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <div style="padding: 0;">
                        <t t-if="company and (company.logo_web or company.logo)">
                            <img t-att-src="'/web/image/res.company/' + str(company.id) + '/logo'" style="height:70px; max-height:70px; width: auto;"/>
                        </t>
                    </div>
                    <div style="text-align: right; padding: 0;">
                        <div style="font-size: 13px; font-weight: 700; color: #0d2d5e; text-transform: uppercase;"><t t-esc="account_number"/></div>
                    </div>
                </div>
                <div style="border-bottom: 1px solid #0d2d5e; margin-bottom: 8px; width: 100%;"></div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-size: 11px; font-weight: 700; color: #0d2d5e;">BRANCH: <t t-esc="branch_name"/> - Investors</div>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-size: 13px; font-weight: 700; color: #0d2d5e; text-transform: uppercase;"><t t-esc="statement_title or 'ACCOUNT STATEMENT'"/></div>
                    </div>
                </div>
            </div>

            <!-- Page Content -->
            <div class="page">
                <div class="alba-acct-page" style="font-family: 'Source Sans 3', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #111827; background: #ffffff; padding-top: 5px;">

                    <style>
                        /* ── Base table ────────────────────────────────── */
                        .alba-acct-page .stmt-table {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 12.5px;
                        }
                        .alba-acct-page .stmt-table thead tr {
                            border-top: 2px solid #0d2d5e;
                            border-bottom: 2px solid #0d2d5e;
                        }
                        .alba-acct-page .stmt-table th {
                            padding: 8px 10px;
                            text-align: left;
                            font-weight: 700;
                            color: #0d2d5e;
                            font-size: 13px;
                            background: #ffffff;
                        }
                        .alba-acct-page .stmt-table th.num { text-align: right; }
                        .alba-acct-page .stmt-table tbody tr {
                            border-bottom: 1px solid #c8d9f0;
                        }
                        .alba-acct-page .stmt-table tbody tr:last-child { border-bottom: none; }
                        .alba-acct-page .stmt-table td {
                            padding: 9px 10px;
                            vertical-align: top;
                            color: #111827;
                        }
                        .alba-acct-page .stmt-table td.num { text-align: right; }
                        .alba-acct-page .stmt-table td.date { white-space: nowrap; min-width: 90px; }
                        .alba-acct-page .stmt-table td.desc { color: #374151; }
                        .alba-acct-page .stmt-table tfoot tr {
                            border-top: 2px solid #0d2d5e;
                            border-bottom: 2px solid #0d2d5e;
                        }
                        .alba-acct-page .stmt-table tfoot td {
                            font-weight: 700;
                            color: #0d2d5e;
                            padding: 9px 10px;
                            font-size: 13px;
                        }
                        .alba-acct-page .stmt-table tfoot td.num { text-align: right; }

                        /* ── Transaction type badges ───────────────────── */
                        .alba-acct-page .tx-badge {
                            display: inline-block;
                            padding: 2px 7px;
                            border-radius: 4px;
                            font-size: 9.5px;
                            font-weight: 700;
                            text-transform: uppercase;
                            letter-spacing: 0.4px;
                            white-space: nowrap;
                        }
                        .alba-acct-page .tx-badge.deposit  { background: #d1fae5; color: #065f46; }
                        .alba-acct-page .tx-badge.topup    { background: #d1fae5; color: #065f46; }
                        .alba-acct-page .tx-badge.accrual  { background: #dbeafe; color: #1e40af; }
                        .alba-acct-page .tx-badge.payout   { background: #fce7f3; color: #9d174d; }
                        .alba-acct-page .tx-badge.withdrawal { background: #fee2e2; color: #991b1b; }
                        .alba-acct-page .tx-badge.opening  { background: #f3f4f6; color: #374151; }

                        /* ── Accrual status badges ─────────────────────── */
                        .alba-acct-page .accrual-status {
                            display: inline-block;
                            padding: 2px 7px;
                            border-radius: 10px;
                            font-size: 9.5px;
                            font-weight: 700;
                            text-transform: uppercase;
                        }
                        .alba-acct-page .accrual-status.outstanding { background: #fff7ed; color: #c2410c; }
                        .alba-acct-page .accrual-status.paid        { background: #d1fae5; color: #065f46; }

                        /* ── Section headers ───────────────────────────── */
                        .alba-acct-page .section-header {
                            margin-top: 28px;
                            margin-bottom: 10px;
                            font-size: 13px;
                            font-weight: 700;
                            color: #0d2d5e;
                            border-bottom: 2px solid #0d2d5e;
                            padding-bottom: 4px;
                            text-transform: uppercase;
                            page-break-inside: avoid;
                        }
                    </style>

                    <!-- Customer Info -->
                    <table width="100%" style="margin-bottom: 20px; border-collapse: collapse;">
                        <tr>
                            <td width="48%" style="padding: 12px 0; vertical-align: top; background-color: #ffffff;">
                                <div style="margin-bottom: 12px;">
                                    <div style="font-weight: 700; color: #0d2d5e; font-size: 12px; margin-bottom: 4px;">Customer Name</div>
                                    <div style="color: #111827; font-size: 13px;">
                                        <t t-esc="customer_name"/>
                                    </div>
                                </div>
                                <div>
                                    <div style="font-weight: 700; color: #0d2d5e; font-size: 12px; margin-bottom: 4px;">Address</div>
                                    <div style="color: #111827; font-size: 13px;">
                                        <t t-esc="customer_address"/>
                                    </div>
                                </div>
                            </td>
                            <td width="4%"/>
                            <td width="48%" style="padding: 12px 0; vertical-align: top; background-color: #ffffff;">
                                <table width="100%" style="border-collapse: collapse;">
                                    <tr>
                                        <td style="font-weight: 700; color: #0d2d5e; font-size: 12px; padding-bottom: 10px; vertical-align: top; width: 60%;">Account No.</td>
                                        <td style="font-weight: 700; color: #0d2d5e; padding-bottom: 10px; vertical-align: top; width: 8%;">:</td>
                                        <td style="color: #111827; font-size: 13px; padding-bottom: 10px; vertical-align: top;"><t t-esc="account_number"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: 700; color: #0d2d5e; font-size: 12px; padding-bottom: 10px; vertical-align: top;">Product</td>
                                        <td style="font-weight: 700; color: #0d2d5e; padding-bottom: 10px; vertical-align: top;">:</td>
                                        <td style="color: #111827; font-size: 13px; padding-bottom: 10px; vertical-align: top;"><t t-esc="product_name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: 700; color: #0d2d5e; font-size: 12px; padding-bottom: 10px; vertical-align: top;">Period</td>
                                        <td style="font-weight: 700; color: #0d2d5e; padding-bottom: 10px; vertical-align: top;">:</td>
                                        <td style="color: #111827; font-size: 13px; padding-bottom: 10px; vertical-align: top;">
                                            <t t-esc="date_from"/> to <t t-esc="date_to"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: 700; color: #0d2d5e; font-size: 12px; vertical-align: top;">Statement Date</td>
                                        <td style="font-weight: 700; color: #0d2d5e; vertical-align: top;">:</td>
                                        <td style="color: #111827; font-size: 13px; vertical-align: top;"><t t-esc="statement_date"/></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- Financial Summary Box -->
                    <t t-if="opening_balance_fmt">
                        <table width="100%" style="margin-bottom: 20px; border-collapse: collapse; border: 1.5px solid #0d2d5e;">
                            <thead>
                                <tr style="background-color: #ffffff; border-top: 2px solid #0d2d5e; border-bottom: 2px solid #0d2d5e;">
                                    <th style="padding: 10px 12px; font-size: 11px; font-weight: 700; color: #0d2d5e; text-align: center; border-right: 1px solid #c8d9f0;">Opening Balance</th>
                                    <th style="padding: 10px 12px; font-size: 11px; font-weight: 700; color: #0d2d5e; text-align: center; border-right: 1px solid #c8d9f0;">Deposits / Top-Ups</th>
                                    <th style="padding: 10px 12px; font-size: 11px; font-weight: 700; color: #0d2d5e; text-align: center; border-right: 1px solid #c8d9f0;">Withdrawals</th>
                                    <th style="padding: 10px 12px; font-size: 11px; font-weight: 700; color: #0d2d5e; text-align: center; border-right: 1px solid #c8d9f0;">Total Interest Accrued</th>
                                    <th style="padding: 10px 12px; font-size: 11px; font-weight: 700; color: #0d2d5e; text-align: center;">Closing Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="background-color: #ffffff; border-bottom: 1px solid #0d2d5e;">
                                    <td style="padding: 12px 12px; font-size: 13px; font-weight: 600; color: #0d2d5e; text-align: center; border-right: 1px solid #c8d9f0;"><t t-esc="opening_balance_fmt"/></td>
                                    <td style="padding: 12px 12px; font-size: 13px; font-weight: 600; color: #065f46; text-align: center; border-right: 1px solid #c8d9f0;"><t t-esc="deposits_fmt"/></td>
                                    <td style="padding: 12px 12px; font-size: 13px; font-weight: 600; color: #991b1b; text-align: center; border-right: 1px solid #c8d9f0;"><t t-esc="withdrawals_fmt"/></td>
                                    <td style="padding: 12px 12px; font-size: 13px; font-weight: 600; color: #1e40af; text-align: center; border-right: 1px solid #c8d9f0;"><t t-esc="interest_accrued_fmt"/></td>
                                    <td style="padding: 12px 12px; font-size: 13px; font-weight: 700; color: #0d2d5e; text-align: center;"><t t-esc="closing_balance_fmt"/></td>
                                </tr>
                                <!-- Interest Settlement Sub-table -->
                                <tr style="background-color: #f3f7fc;">
                                    <td colspan="5" style="padding: 4px 10px; font-size: 10px; font-weight: 700; color: #0d2d5e; text-transform: uppercase; border-bottom: 1px solid #0d2d5e;">Interest Settlement Summary</td>
                                </tr>
                                <tr style="background-color: #ffffff;">
                                    <td colspan="5" style="padding: 0;">
                                        <table width="100%" style="border-collapse: collapse; margin: 0; border: none;">
                                            <thead>
                                                <tr style="border-bottom: 1px solid #c8d9f0; background-color: #fafafa;">
                                                    <th style="padding: 8px 10px; font-size: 11px; font-weight: 700; color: #0d2d5e; text-align: center; border-right: 1px solid #c8d9f0; width: 25%;">Total Interest Paid Out (Gross)</th>
                                                    <th style="padding: 8px 10px; font-size: 11px; font-weight: 700; color: #0d2d5e; text-align: center; border-right: 1px solid #c8d9f0; width: 25%;">Total WHT Deducted (<t t-esc="wht_rate"/>%)</th>
                                                    <th style="padding: 8px 10px; font-size: 11px; font-weight: 700; color: #0d2d5e; text-align: center; border-right: 1px solid #c8d9f0; width: 25%;">Total Net Interest Paid</th>
                                                    <th style="padding: 8px 10px; font-size: 11px; font-weight: 700; color: #0d2d5e; text-align: center; width: 25%;">Interest Outstanding</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td style="padding: 10px; font-size: 12px; font-weight: 600; color: #0d2d5e; text-align: center; border-right: 1px solid #c8d9f0;"><t t-esc="total_gross_paid_fmt"/></td>
                                                    <td style="padding: 10px; font-size: 12px; font-weight: 600; color: #0d2d5e; text-align: center; border-right: 1px solid #c8d9f0;"><t t-esc="total_wht_deducted_fmt"/></td>
                                                    <td style="padding: 10px; font-size: 12px; font-weight: 600; color: #0d2d5e; text-align: center; border-right: 1px solid #c8d9f0;"><t t-esc="total_net_paid_fmt"/></td>
                                                    <td style="padding: 10px; font-size: 12px; font-weight: 700; color: #c2410c; text-align: center;"><t t-esc="interest_outstanding_fmt"/></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>

                    <!-- ── Main Transaction Ledger ─────────────────────────────── -->
                    <table class="stmt-table" style="margin-top: 20px;">
                        <thead>
                            <tr style="background-color: #ffffff; border-top: 2px solid #0d2d5e; border-bottom: 2px solid #0d2d5e;">
                                <th style="color: #0d2d5e; font-weight: 700; padding: 10px 12px; font-size: 12px; text-align: left; width: 90px;">Date</th>
                                <th style="color: #0d2d5e; font-weight: 700; padding: 10px 12px; font-size: 12px; text-align: left; width: 80px;">Type</th>
                                <th style="color: #0d2d5e; font-weight: 700; padding: 10px 12px; font-size: 12px; text-align: left;">Description</th>
                                <th style="color: #0d2d5e; font-weight: 700; padding: 10px 12px; font-size: 12px; text-align: right;">Debits</th>
                                <th style="color: #0d2d5e; font-weight: 700; padding: 10px 12px; font-size: 12px; text-align: right;">Credits</th>
                                <th style="color: #0d2d5e; font-weight: 700; padding: 10px 12px; font-size: 12px; text-align: right;">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="line">
                                <tr style="border-bottom: 1px solid #c8d9f0;">
                                    <td class="date" style="color: #0d2d5e; font-weight: 600; padding: 9px 12px; font-size: 12px; white-space: nowrap;"><t t-esc="line['date']"/></td>
                                    <td style="padding: 9px 12px; font-size: 11px; vertical-align: middle;">
                                        <t t-if="line.get('type') == 'deposit'">
                                            <span class="tx-badge deposit"><t t-esc="line.get('type_label') or 'Deposit'"/></span>
                                        </t>
                                        <t t-elif="line.get('type') == 'topup'">
                                            <span class="tx-badge topup"><t t-esc="line.get('type_label') or 'Top-Up'"/></span>
                                        </t>
                                        <t t-elif="line.get('type') == 'accrual'">
                                            <span class="tx-badge accrual"><t t-esc="line.get('type_label') or 'Accrual'"/></span>
                                        </t>
                                        <t t-elif="line.get('type') == 'payout'">
                                            <span class="tx-badge payout"><t t-esc="line.get('type_label') or 'Payout'"/></span>
                                        </t>
                                        <t t-elif="line.get('type') == 'withdrawal'">
                                            <span class="tx-badge withdrawal"><t t-esc="line.get('type_label') or 'Withdrawal'"/></span>
                                        </t>
                                        <t t-else="">
                                            <span class="tx-badge opening"><t t-esc="line.get('type_label') or ''"/></span>
                                        </t>
                                    </td>
                                    <td class="desc" style="color: #374151; padding: 9px 12px; font-size: 12px;"><t t-esc="line['description']"/></td>
                                    <td class="num" style="color: #991b1b; font-weight: 600; padding: 9px 12px; font-size: 12px; text-align: right;"><t t-esc="line['debit_fmt']"/></td>
                                    <td class="num" style="color: #065f46; font-weight: 600; padding: 9px 12px; font-size: 12px; text-align: right;"><t t-esc="line['credit_fmt']"/></td>
                                    <td class="num" style="color: #0d2d5e; font-weight: 700; padding: 9px 12px; font-size: 12px; text-align: right;"><t t-esc="line['balance_fmt']"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr style="border-top: 2px solid #0d2d5e; border-bottom: 2px solid #0d2d5e; background-color: #ffffff;">
                                <td colspan="3" style="text-align: center; font-weight: 700; color: #0d2d5e; padding: 10px 12px; font-size: 12px;">Totals</td>
                                <td class="num" style="font-weight: 700; color: #991b1b; padding: 10px 12px; font-size: 12px; text-align: right;"><t t-esc="total_debit_fmt"/></td>
                                <td class="num" style="font-weight: 700; color: #065f46; padding: 10px 12px; font-size: 12px; text-align: right;"><t t-esc="total_credit_fmt"/></td>
                                <td class="num"/>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- ── Section: Deposits &amp; Top-Ups Detail ──────────────── -->
                    <t t-if="topup_lines">
                        <div class="section-header">Deposits &amp; Top-Ups Detail</div>
                        <table class="stmt-table" style="margin-top: 10px; margin-bottom: 20px; page-break-inside: avoid;">
                            <thead>
                                <tr style="background-color: #ffffff; border-top: 2px solid #0d2d5e; border-bottom: 2px solid #0d2d5e;">
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: left;">Date</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: left;">Reference</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: right;">Amount</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: center; width: 90px;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="topup_lines" t-as="t_line">
                                    <tr style="border-bottom: 1px solid #c8d9f0;">
                                        <td class="date" style="color: #0d2d5e; font-weight: 600; padding: 8px 10px; font-size: 12px;"><t t-esc="t_line['date']"/></td>
                                        <td style="color: #374151; padding: 8px 10px; font-size: 12px;"><t t-esc="t_line['reference']"/></td>
                                        <td class="num" style="color: #065f46; font-weight: 600; padding: 8px 10px; font-size: 12px; text-align: right;"><t t-esc="t_line['amount_fmt']"/></td>
                                        <td style="color: #0d2d5e; padding: 8px 10px; font-size: 12px; text-align: center;"><t t-esc="t_line['status']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- ── Section: Interest Accrual History ──────────────────── -->
                    <t t-if="accrual_lines">
                        <div class="section-header">Interest Accrual History</div>
                        <table class="stmt-table" style="margin-top: 10px; margin-bottom: 20px; page-break-inside: avoid;">
                            <thead>
                                <tr style="background-color: #ffffff; border-top: 2px solid #0d2d5e; border-bottom: 2px solid #0d2d5e;">
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: left;">Accrual Date</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: left;">Period Start</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: left;">Period End</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: right;">Opening Balance</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: right;">Interest Amount</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: right;">Closing Balance</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: center; width: 100px;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="accrual_lines" t-as="a_line">
                                    <tr style="border-bottom: 1px solid #c8d9f0;">
                                        <td class="date" style="color: #0d2d5e; font-weight: 600; padding: 8px 10px; font-size: 12px;"><t t-esc="a_line['accrual_date']"/></td>
                                        <td style="color: #374151; padding: 8px 10px; font-size: 12px;"><t t-esc="a_line['period_start']"/></td>
                                        <td style="color: #374151; padding: 8px 10px; font-size: 12px;"><t t-esc="a_line['period_end']"/></td>
                                        <td class="num" style="color: #0d2d5e; font-weight: 600; padding: 8px 10px; font-size: 12px; text-align: right;"><t t-esc="a_line['opening_balance_fmt']"/></td>
                                        <td class="num" style="color: #1e40af; font-weight: 600; padding: 8px 10px; font-size: 12px; text-align: right;"><t t-esc="a_line['interest_amount_fmt']"/></td>
                                        <td class="num" style="color: #0d2d5e; font-weight: 600; padding: 8px 10px; font-size: 12px; text-align: right;"><t t-esc="a_line['closing_balance_fmt']"/></td>
                                        <td style="padding: 8px 10px; font-size: 11px; text-align: center;">
                                            <t t-if="a_line.get('status_class') == 'paid'">
                                                <span class="accrual-status paid"><t t-esc="a_line['status']"/></span>
                                            </t>
                                            <t t-else="">
                                                <span class="accrual-status outstanding"><t t-esc="a_line['status']"/></span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- ── Section: Interest Payout Records ───────────────────── -->
                    <t t-if="payout_lines">
                        <div class="section-header">Interest Payout Records</div>
                        <table class="stmt-table" style="margin-top: 10px; margin-bottom: 20px; page-break-inside: avoid;">
                            <thead>
                                <tr style="background-color: #ffffff; border-top: 2px solid #0d2d5e; border-bottom: 2px solid #0d2d5e;">
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: left;">Payout Date</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: left;">Reference</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: left;">Accruals Covered</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: right;">Gross Interest</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: right;">WHT Deducted</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: right;">Net Paid</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: left;">Payment Reference</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="payout_lines" t-as="p_line">
                                    <tr style="border-bottom: 1px solid #c8d9f0;">
                                        <td class="date" style="color: #0d2d5e; font-weight: 600; padding: 8px 10px; font-size: 12px;"><t t-esc="p_line['payout_date']"/></td>
                                        <td style="color: #374151; padding: 8px 10px; font-size: 12px;"><t t-esc="p_line['reference']"/></td>
                                        <td style="color: #374151; padding: 8px 10px; font-size: 12px;"><t t-esc="p_line['accrual_range']"/></td>
                                        <td class="num" style="color: #0d2d5e; font-weight: 600; padding: 8px 10px; font-size: 12px; text-align: right;"><t t-esc="p_line['gross_interest_fmt']"/></td>
                                        <td class="num" style="color: #991b1b; font-weight: 600; padding: 8px 10px; font-size: 12px; text-align: right;"><t t-esc="p_line['wht_deducted_fmt']"/></td>
                                        <td class="num" style="color: #065f46; font-weight: 600; padding: 8px 10px; font-size: 12px; text-align: right;"><t t-esc="p_line['net_paid_fmt']"/></td>
                                        <td style="color: #374151; padding: 8px 10px; font-size: 12px;"><t t-esc="p_line['payment_ref']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- ── Section: Withdrawal Records ────────────────────────── -->
                    <t t-if="withdrawal_lines">
                        <div class="section-header">Investment Withdrawal Records</div>
                        <table class="stmt-table" style="margin-top: 10px; margin-bottom: 20px; page-break-inside: avoid;">
                            <thead>
                                <tr style="background-color: #ffffff; border-top: 2px solid #0d2d5e; border-bottom: 2px solid #0d2d5e;">
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: left;">Withdrawal Date</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: left;">Payment Reference</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: right;">Principal</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: right;">Top-Ups</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: right;">Accrued Interest</th>
                                    <th style="color: #0d2d5e; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: right;">Total Paid Out</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="withdrawal_lines" t-as="w_line">
                                    <tr style="border-bottom: 1px solid #c8d9f0;">
                                        <td class="date" style="color: #0d2d5e; font-weight: 600; padding: 8px 10px; font-size: 12px;"><t t-esc="w_line['date']"/></td>
                                        <td style="color: #374151; padding: 8px 10px; font-size: 12px;"><t t-esc="w_line['reference']"/></td>
                                        <td class="num" style="color: #0d2d5e; font-weight: 600; padding: 8px 10px; font-size: 12px; text-align: right;"><t t-esc="w_line['principal_fmt']"/></td>
                                        <td class="num" style="color: #065f46; font-weight: 600; padding: 8px 10px; font-size: 12px; text-align: right;"><t t-esc="w_line['topups_fmt']"/></td>
                                        <td class="num" style="color: #1e40af; font-weight: 600; padding: 8px 10px; font-size: 12px; text-align: right;"><t t-esc="w_line['interest_fmt']"/></td>
                                        <td class="num" style="color: #991b1b; font-weight: 700; padding: 8px 10px; font-size: 12px; text-align: right;"><t t-esc="w_line['gross_fmt']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                </div>
            </div>

            <!-- Custom Footer -->
            <div class="footer" style="font-family: 'Source Sans 3', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 9px; color: #111827; border-top: 1.5px solid #0d2d5e; padding-top: 6px;">
                <table width="100%" style="border-collapse: collapse;">
                    <tr>
                        <td style="width: 75%; line-height: 1.4;">
                            <span style="font-weight: 700; color: #0d2d5e;"><t t-esc="company.name"/></span> | 
                            Address: <t t-esc="company.street or ''"/>, <t t-esc="company.city or ''"/> | 
                            Phone: <t t-esc="company.phone or ''"/> | 
                            Email: <t t-esc="company.email or ''"/> | 
                            Web: <t t-esc="company.website or ''"/>
                            <br/>
                            <span style="font-style: italic; color: #9ca3af; font-size: 8.5px;">This is a system generated statement. Please report any discrepancies within 14 days.</span>
                        </td>
                        <td style="width: 25%; text-align: right; vertical-align: bottom; white-space: nowrap; font-size: 10px; font-weight: 700; color: #0d2d5e;">
                            Page <span class="page"/> of <span class="topage"/>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

