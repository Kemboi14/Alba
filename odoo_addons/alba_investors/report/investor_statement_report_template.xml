<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shared account statement layout (bank-style PDF) -->
    <template id="account_statement_document">
        <!-- Set company BEFORE calling basic_layout for proper scoping -->
        <t t-set="company" t-value="res_company or company or (docs and docs[0].company_id) or (o and o.company_id) or env.company"/>
        <t t-call="web.basic_layout">

            <!-- Custom Header -->
            <div class="header" style="font-family: 'Source Sans 3', 'Helvetica Neue', Helvetica, Arial, sans-serif; border-bottom: 3px solid #0d2d5e; padding: 16px 0; margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between; gap: 20px;">
                <div style="flex: 0 0 auto;">
                    <t t-if="company and (company.logo_web or company.logo)">
                        <img t-att-src="'/web/image/res.company/' + str(company.id) + '/logo'" style="height:100px; max-height:100px; width: auto; display: block;"/>
                    </t>
                </div>
                <div style="flex: 1; text-align: right;">
                    <div style="font-size: 18px; font-weight: 800; color: #0d2d5e; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 6px; line-height: 1.2;">
                        <t t-esc="statement_title or 'ACCOUNT STATEMENT'"/>
                    </div>
                    <div style="font-size: 12px; color: #0d2d5e; font-weight: 700; line-height: 1.5;">
                        BRANCH: <t t-esc="branch_name"/> - Investors
                    </div>
                </div>
            </div>

            <!-- Page Content -->
            <div class="page">
                <div class="alba-acct-page" style="font-family: 'Source Sans 3', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #111827; background: #ffffff; padding-top: 5px;">

                    <style>
                        .alba-acct-page .stmt-table {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 12.5px;
                        }
                        .alba-acct-page .stmt-table thead tr {
                            border-top: 2px solid #0d2d5e;
                            border-bottom: 2px solid #0d2d5e;
                        }
                        .alba-acct-page .stmt-table th {
                            padding: 8px 10px;
                            text-align: left;
                            font-weight: 700;
                            color: #0d2d5e;
                            font-size: 13px;
                            background: #ffffff;
                        }
                        .alba-acct-page .stmt-table th.num { text-align: right; }
                        .alba-acct-page .stmt-table tbody tr {
                            border-bottom: 1px solid #c8d9f0;
                        }
                        .alba-acct-page .stmt-table tbody tr:last-child { border-bottom: none; }
                        .alba-acct-page .stmt-table td {
                            padding: 9px 10px;
                            vertical-align: top;
                            color: #111827;
                        }
                        .alba-acct-page .stmt-table td.num { text-align: right; }
                        .alba-acct-page .stmt-table td.date { white-space: nowrap; min-width: 90px; }
                        .alba-acct-page .stmt-table td.desc { color: #4b5563; }
                        .alba-acct-page .stmt-table tfoot tr {
                            border-top: 2px solid #0d2d5e;
                            border-bottom: 2px solid #0d2d5e;
                        }
                        .alba-acct-page .stmt-table tfoot td {
                            font-weight: 700;
                            color: #0d2d5e;
                            padding: 9px 10px;
                            font-size: 13px;
                        }
                        .alba-acct-page .stmt-table tfoot td.num { text-align: right; }
                    </style>

                    <div style="margin-bottom: 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <!-- Customer Info Box -->
                        <div style="border: 2px solid #2e6bbf; border-radius: 8px; padding: 18px; background-color: #f9fbfd;">
                            <div style="margin-bottom: 16px;">
                                <div style="font-weight: 800; color: #0d2d5e; font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; line-height: 1.2;">Customer Name</div>
                                <div style="color: #111827; font-size: 14px; font-weight: 600; line-height: 1.4;">
                                    <t t-esc="customer_name"/>
                                </div>
                            </div>
                            <div>
                                <div style="font-weight: 800; color: #0d2d5e; font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; line-height: 1.2;">Address</div>
                                <div style="color: #111827; font-size: 13px; line-height: 1.6;">
                                    <t t-esc="customer_address"/>
                                </div>
                            </div>
                        </div>
                        <!-- Account Details Box -->
                        <div style="border: 2px solid #2e6bbf; border-radius: 8px; padding: 18px; background-color: #f9fbfd;">
                            <div style="margin-bottom: 16px;">
                                <div style="font-weight: 800; color: #0d2d5e; font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; line-height: 1.2;">Account No.</div>
                                <div style="color: #111827; font-size: 14px; font-weight: 700;">
                                    <t t-esc="account_number"/>
                                </div>
                            </div>
                            <div style="margin-bottom: 16px;">
                                <div style="font-weight: 800; color: #0d2d5e; font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; line-height: 1.2;">Product</div>
                                <div style="color: #111827; font-size: 14px; font-weight: 700;">
                                    <t t-esc="product_name"/>
                                </div>
                            </div>
                            <div style="margin-bottom: 16px;">
                                <div style="font-weight: 800; color: #0d2d5e; font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; line-height: 1.2;">Period</div>
                                <div style="color: #111827; font-size: 14px; font-weight: 700;">
                                    <t t-esc="date_from"/> to <t t-esc="date_to"/>
                                </div>
                            </div>
                            <div>
                                <div style="font-weight: 800; color: #0d2d5e; font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; line-height: 1.2;">Statement Date</div>
                                <div style="color: #111827; font-size: 14px; font-weight: 700;">
                                    <t t-esc="statement_date"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Financial Summary Box with Withholding Tax (WHT) -->
                    <t t-if="opening_balance_fmt">
                        <table width="100%" style="margin-bottom: 24px; border-collapse: collapse; border: 2px solid #0d2d5e; border-radius: 8px; overflow: hidden;">
                            <thead>
                                <tr style="background: linear-gradient(135deg, #0d2d5e 0%, #1a3d7a 100%);">
                                    <th style="padding: 14px 12px; font-size: 11px; font-weight: 800; text-transform: uppercase; color: #ffffff; letter-spacing: 0.6px; text-align: center; border-right: 1px solid #2e6bbf;">Opening Balance</th>
                                    <th style="padding: 14px 12px; font-size: 11px; font-weight: 800; text-transform: uppercase; color: #ffffff; letter-spacing: 0.6px; text-align: center; border-right: 1px solid #2e6bbf;">Deposits</th>
                                    <th style="padding: 14px 12px; font-size: 11px; font-weight: 800; text-transform: uppercase; color: #ffffff; letter-spacing: 0.6px; text-align: center; border-right: 1px solid #2e6bbf;">Withdrawals</th>
                                    <th style="padding: 14px 12px; font-size: 11px; font-weight: 800; text-transform: uppercase; color: #ffffff; letter-spacing: 0.6px; text-align: center; border-right: 1px solid #2e6bbf;">Interest Accrued</th>
                                    <th style="padding: 14px 12px; font-size: 11px; font-weight: 800; text-transform: uppercase; color: #ffffff; letter-spacing: 0.6px; text-align: center; border-right: 1px solid #2e6bbf;">WHT Deducted (<t t-esc="wht_rate"/>%)</th>
                                    <th style="padding: 14px 12px; font-size: 11px; font-weight: 800; text-transform: uppercase; color: #ffffff; letter-spacing: 0.6px; text-align: center; border-right: 1px solid #2e6bbf;">Net Interest</th>
                                    <th style="padding: 14px 12px; font-size: 11px; font-weight: 800; text-transform: uppercase; color: #ffffff; letter-spacing: 0.6px; text-align: center;">Closing Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="background-color: #ffffff;">
                                    <td style="padding: 16px 12px; font-size: 13px; font-weight: 700; color: #0d2d5e; text-align: center; border-right: 1px solid #e0e8f0;"><t t-esc="opening_balance_fmt"/></td>
                                    <td style="padding: 16px 12px; font-size: 13px; font-weight: 700; color: #0d2d5e; text-align: center; border-right: 1px solid #e0e8f0;"><t t-esc="deposits_fmt"/></td>
                                    <td style="padding: 16px 12px; font-size: 13px; font-weight: 700; color: #d9534f; text-align: center; border-right: 1px solid #e0e8f0;"><t t-esc="withdrawals_fmt"/></td>
                                    <td style="padding: 16px 12px; font-size: 13px; font-weight: 700; color: #0d2d5e; text-align: center; border-right: 1px solid #e0e8f0;"><t t-esc="interest_accrued_fmt"/></td>
                                    <td style="padding: 16px 12px; font-size: 13px; font-weight: 800; color: #d9534f; text-align: center; border-right: 1px solid #e0e8f0;"><t t-esc="wht_amount_fmt"/></td>
                                    <td style="padding: 16px 12px; font-size: 13px; font-weight: 800; color: #0d2d5e; text-align: center; border-right: 1px solid #e0e8f0;"><t t-esc="net_interest_fmt"/></td>
                                    <td style="padding: 16px 12px; font-size: 14px; font-weight: 800; color: #0d2d5e; text-align: center;"><t t-esc="closing_balance_fmt"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>

                    <table class="stmt-table">
                        <thead>
                            <tr style="background-color: #0d2d5e;">
                                <th style="color: #ffffff; font-weight: 800; padding: 14px 12px; font-size: 12px; text-align: left; text-transform: uppercase; letter-spacing: 0.6px;">Date</th>
                                <th style="color: #ffffff; font-weight: 800; padding: 14px 12px; font-size: 12px; text-align: left; text-transform: uppercase; letter-spacing: 0.6px;">Description</th>
                                <th style="color: #ffffff; font-weight: 800; padding: 14px 12px; font-size: 12px; text-align: right; text-transform: uppercase; letter-spacing: 0.6px;">Debits</th>
                                <th style="color: #ffffff; font-weight: 800; padding: 14px 12px; font-size: 12px; text-align: right; text-transform: uppercase; letter-spacing: 0.6px;">Credits</th>
                                <th style="color: #ffffff; font-weight: 800; padding: 14px 12px; font-size: 12px; text-align: right; text-transform: uppercase; letter-spacing: 0.6px;">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="line">
                                <tr>
                                    <td class="date" style="color: #0d2d5e; font-weight: 600; padding: 12px 12px; font-size: 13px;"><t t-esc="line['date']"/></td>
                                    <td class="desc" style="color: #111827; padding: 12px 12px; font-size: 13px;"><t t-esc="line['description']"/></td>
                                    <td class="num" style="color: #d9534f; font-weight: 700; padding: 12px 12px; font-size: 13px; text-align: right;"><t t-esc="line['debit_fmt']"/></td>
                                    <td class="num" style="color: #0d2d5e; font-weight: 700; padding: 12px 12px; font-size: 13px; text-align: right;"><t t-esc="line['credit_fmt']"/></td>
                                    <td class="num" style="color: #0d2d5e; font-weight: 700; padding: 12px 12px; font-size: 13px; text-align: right;"><t t-esc="line['balance_fmt']"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" style="text-align: center;">Totals</td>
                                <td class="num"><t t-esc="total_debit_fmt"/></td>
                                <td class="num"><t t-esc="total_credit_fmt"/></td>
                                <td class="num"/>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Custom Footer -->
            <div class="footer" style="font-family: 'Source Sans 3', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 9px; color: #111827; border-top: 3px solid #0d2d5e; padding-top: 10px; margin-top: 8px;">
                <table width="100%" style="border-collapse: collapse;">
                    <tr>
                        <td style="width: 75%; line-height: 1.5;">
                            <span style="font-weight: 700; color: #0d2d5e; font-size: 9.5px;"><t t-esc="company.name"/></span> | 
                            Address: <t t-esc="company.street or ''"/>, <t t-esc="company.city or ''"/> | 
                            Phone: <t t-esc="company.phone or ''"/> | 
                            Email: <t t-esc="company.email or ''"/> | 
                            Web: <t t-esc="company.website or ''"/>
                            <br/>
                            <span style="font-style: italic; color: #9ca3af; font-size: 8px; margin-top: 3px; display: block;">This is a system generated statement. Please report any discrepancies within 14 days.</span>
                        </td>
                        <td style="width: 25%; text-align: right; vertical-align: bottom; white-space: nowrap; font-size: 10px; font-weight: 600; color: #0d2d5e;">
                            Page <span class="page"/> of <span class="topage"/>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_investment_statement_template">
        <t t-call="web.html_container">
            <t t-foreach="statements" t-as="stmt_data">
                <t t-set="res_company" t-value="stmt_data['res_company']"/>
                <t t-set="company" t-value="stmt_data['res_company']"/>
                <t t-call="alba_investors.account_statement_document">
                    <t t-set="statement_title" t-value="'INVESTMENT STATEMENT'"/>
                    <t t-set="branch_name" t-value="stmt_data['branch_name']"/>
                    <t t-set="customer_name" t-value="stmt_data['customer_name']"/>
                    <t t-set="customer_address" t-value="stmt_data['customer_address']"/>
                    <t t-set="account_number" t-value="stmt_data['account_number']"/>
                    <t t-set="product_name" t-value="stmt_data['product_name']"/>
                    <t t-set="date_from" t-value="stmt_data['date_from']"/>
                    <t t-set="date_to" t-value="stmt_data['date_to']"/>
                    <t t-set="statement_date" t-value="stmt_data['statement_date']"/>
                    <t t-set="lines" t-value="stmt_data['lines']"/>
                    <t t-set="total_debit_fmt" t-value="stmt_data['total_debit_fmt']"/>
                    <t t-set="total_credit_fmt" t-value="stmt_data['total_credit_fmt']"/>
                    <t t-set="opening_balance_fmt" t-value="stmt_data.get('opening_balance_fmt')"/>
                    <t t-set="deposits_fmt" t-value="stmt_data.get('deposits_fmt')"/>
                    <t t-set="withdrawals_fmt" t-value="stmt_data.get('withdrawals_fmt')"/>
                    <t t-set="interest_accrued_fmt" t-value="stmt_data.get('interest_accrued_fmt')"/>
                    <t t-set="wht_amount_fmt" t-value="stmt_data.get('wht_amount_fmt')"/>
                    <t t-set="net_interest_fmt" t-value="stmt_data.get('net_interest_fmt')"/>
                    <t t-set="closing_balance_fmt" t-value="stmt_data.get('closing_balance_fmt')"/>
                    <t t-set="wht_rate" t-value="stmt_data.get('wht_rate')"/>
                </t>
            </t>
        </t>
    </template>

    <template id="investor_statement_template">
        <t t-call="web.html_container">
            <t t-foreach="statements" t-as="stmt_data">
                <t t-set="res_company" t-value="stmt_data['res_company']"/>
                <t t-set="company" t-value="stmt_data['res_company']"/>
                <t t-call="alba_investors.account_statement_document">
                    <t t-set="statement_title" t-value="'INVESTOR ACCOUNT STATEMENT'"/>
                    <t t-set="branch_name" t-value="stmt_data['branch_name']"/>
                    <t t-set="customer_name" t-value="stmt_data['customer_name']"/>
                    <t t-set="customer_address" t-value="stmt_data['customer_address']"/>
                    <t t-set="account_number" t-value="stmt_data['account_number']"/>
                    <t t-set="product_name" t-value="stmt_data['product_name']"/>
                    <t t-set="date_from" t-value="stmt_data['date_from']"/>
                    <t t-set="date_to" t-value="stmt_data['date_to']"/>
                    <t t-set="statement_date" t-value="stmt_data['statement_date']"/>
                    <t t-set="lines" t-value="stmt_data['lines']"/>
                    <t t-set="total_debit_fmt" t-value="stmt_data['total_debit_fmt']"/>
                    <t t-set="total_credit_fmt" t-value="stmt_data['total_credit_fmt']"/>
                    <t t-set="opening_balance_fmt" t-value="stmt_data.get('opening_balance_fmt')"/>
                    <t t-set="deposits_fmt" t-value="stmt_data.get('deposits_fmt')"/>
                    <t t-set="withdrawals_fmt" t-value="stmt_data.get('withdrawals_fmt')"/>
                    <t t-set="interest_accrued_fmt" t-value="stmt_data.get('interest_accrued_fmt')"/>
                    <t t-set="wht_amount_fmt" t-value="stmt_data.get('wht_amount_fmt')"/>
                    <t t-set="net_interest_fmt" t-value="stmt_data.get('net_interest_fmt')"/>
                    <t t-set="closing_balance_fmt" t-value="stmt_data.get('closing_balance_fmt')"/>
                    <t t-set="wht_rate" t-value="stmt_data.get('wht_rate')"/>
                </t>
            </t>
        </t>
    </template>

    <record id="action_investor_statement_report" model="ir.actions.report">
        <field name="name">Investor Account Statement</field>
        <field name="model">alba.investor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">alba_investors.investor_statement_template</field>
        <field name="report_file">alba_investors.investor_statement_template</field>
        <field name="binding_model_id" ref="alba_investors.model_alba_investor"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="alba_loans.paperformat_a4"/>
    </record>

</odoo>
