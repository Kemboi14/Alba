<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="investor_statement_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="investor">
            <div class="page" style="font-family: Arial, sans-serif; font-size: 12px;">

                <!-- HEADER -->
                <table width="100%" style="margin-bottom: 10px;">
                    <tr>
                        <td width="50%">
                            <img t-if="res_company.logo"
                                 t-att-src="image_data_uri(res_company.logo)"
                                 style="max-height: 80px;"/>
                        </td>
                        <td width="50%" style="text-align: right; vertical-align: top;">
                            <div style="color: #2E75B6; font-size: 22px; font-weight: bold;">
                                <t t-esc="investor.investor_number"/>
                            </div>
                            <img t-att-src="'/report/barcode/Code128/' + (investor.investor_number or 'INV-000')"
                                 style="max-height: 35px; margin-top: 4px;"/>
                        </td>
                    </tr>
                </table>

                <!-- BRANCH + TITLE -->
                <table width="100%" style="margin-bottom: 8px;">
                    <tr>
                        <td>
                            <strong>BRANCH: <t t-esc="res_company.name"/> - Investors</strong>
                        </td>
                        <td style="text-align: right;">
                            <span style="color: #2E75B6; font-size: 16px; font-weight: bold;">
                                ACCOUNT STATEMENT
                            </span>
                        </td>
                    </tr>
                </table>

                <!-- CUSTOMER + ACCOUNT INFO BOXES -->
                <table width="100%" style="margin-bottom: 12px; border-collapse: collapse;">
                    <tr>
                        <!-- Left box: Customer info -->
                        <td width="48%" style="
                            border: 2px solid #2E75B6;
                            padding: 10px 14px;
                            vertical-align: top;">
                            <strong>Customer Name</strong><br/>
                            <t t-esc="investor.partner_id.name"/>
                            <br/><br/>
                            <strong>ID Number</strong><br/>
                            <t t-esc="investor.id_number or ''"/>
                        </td>
                        <td width="4%"></td>
                        <!-- Right box: Account info -->
                        <td width="48%" style="
                            border: 2px solid #2E75B6;
                            padding: 10px 14px;
                            vertical-align: top;">
                            <table width="100%" style="border-collapse: collapse;">
                                <tr>
                                    <td><strong>Investor No.</strong></td>
                                    <td>: <t t-esc="investor.investor_number"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Product</strong></td>
                                    <td>: <t t-esc="getattr(investor, 'product_id', False) and investor.product_id.name or 'Investments Received'"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Period</strong></td>
                                    <td>: <t t-esc="date_from"/> to <t t-esc="date_to"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Statement Date</strong></td>
                                    <td>: <t t-esc="date_to"/></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- TRANSACTIONS TABLE -->
                <table width="100%" style="border-collapse: collapse; margin-bottom: 10px;">
                    <thead>
                        <tr style="background-color: #1F3864; color: white;">
                            <th style="padding: 8px 10px; text-align: left; border: 1px solid #1F3864;">Date</th>
                            <th style="padding: 8px 10px; text-align: left; border: 1px solid #1F3864;">Description</th>
                            <th style="padding: 8px 10px; text-align: right; border: 1px solid #1F3864;">Debits</th>
                            <th style="padding: 8px 10px; text-align: right; border: 1px solid #1F3864;">Credits</th>
                            <th style="padding: 8px 10px; text-align: right; border: 1px solid #1F3864;">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="lines" t-as="line">
                            <tr>
                                <td style="padding: 6px 10px; border: 0.5px solid #cccccc;">
                                    <t t-esc="line['date']"/>
                                </td>
                                <td style="padding: 6px 10px; border: 0.5px solid #cccccc;">
                                    <t t-esc="line['description']"/>
                                </td>
                                <td style="padding: 6px 10px; border: 0.5px solid #cccccc; text-align: right;">
                                    <t t-if="line['debit']">
                                        <t t-esc="'{:,.2f}'.format(line['debit'])"/>
                                    </t>
                                    <t t-else="">0.00</t>
                                </td>
                                <td style="padding: 6px 10px; border: 0.5px solid #cccccc; text-align: right;">
                                    <t t-if="line['credit']">
                                        <t t-esc="'{:,.2f}'.format(line['credit'])"/>
                                    </t>
                                    <t t-else="">0.00</t>
                                </td>
                                <td style="padding: 6px 10px; border: 0.5px solid #cccccc; text-align: right;">
                                    <t t-esc="'{:,.2f}'.format(line['balance'])"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr style="font-weight: bold; background-color: #f2f2f2;">
                            <td colspan="2" style="padding: 8px 10px; text-align: center; border: 1px solid #cccccc;">
                                Totals
                            </td>
                            <td style="padding: 8px 10px; text-align: right; border: 1px solid #cccccc;">
                                <t t-esc="'{:,.2f}'.format(total_debit)"/>
                            </td>
                            <td style="padding: 8px 10px; text-align: right; border: 1px solid #cccccc;">
                                <t t-esc="'{:,.2f}'.format(total_credit)"/>
                            </td>
                            <td style="padding: 8px 10px; border: 1px solid #cccccc;"></td>
                        </tr>
                    </tfoot>
                </table>

            </div>
            </t>
        </t>
    </template>

    <record id="action_investor_statement_report" model="ir.actions.report">
        <field name="name">Investor Account Statement</field>
        <field name="model">alba.investor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">alba_investors.investor_statement_template</field>
        <field name="report_file">alba_investors.investor_statement_template</field>
        <field name="binding_model_id" ref="alba_loans.model_alba_investor"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_a4"/>
    </record>
</odoo>
