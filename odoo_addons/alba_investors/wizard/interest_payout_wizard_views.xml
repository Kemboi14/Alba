<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Interest Payout Wizard — Updated with Partial Payout Mode
         ================================================================ -->
    <record id="view_alba_interest_payout_wizard_form" model="ir.ui.view">
        <field name="name">alba.interest.payout.wizard.form</field>
        <field name="model">alba.interest.payout.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay Accrued Interest">
                <sheet>

                    <!-- Info banner -->
                    <div class="alert alert-success d-flex align-items-center gap-3 mb-3"
                         role="alert"
                         style="border-left: 4px solid #28a745; border-radius: 6px; padding: 14px 18px;">
                        <i class="fa fa-money fa-2x text-success me-3"/>
                        <div class="flex-grow-1">
                            <strong class="d-block" style="font-size: 1.1em;">
                                Interest-Only Payout
                            </strong>
                            <span class="text-muted small">
                                The <b>principal remains intact</b> and the investment stays <b>active</b>.
                                Journal: <code>DR Interest Payable / CR Bank</code> (net) +
                                <code>DR Interest Payable / CR WHT Payable</code> (tax).
                            </span>
                        </div>
                    </div>

                    <group>
                        <group string="Investment">
                            <field name="investment_id" readonly="1"/>
                            <field name="investor_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="wht_rate" readonly="1" string="WHT Rate (%)"/>
                            <field name="total_outstanding" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1" string="Total Outstanding Interest"/>
                        </group>
                        <group string="Payment Parameters">
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="payout_date"/>
                            <field name="memo" readonly="1"/>
                        </group>
                    </group>

                    <!-- Payout Mode Selector -->
                    <group string="Payout Mode">
                        <field name="payout_mode" widget="radio"/>
                    </group>

                    <!-- Select Months: accrual picker (only for 'select' mode) -->
                    <group string="Select Accrual Periods"
                           invisible="payout_mode != 'select'">
                        <field name="selected_accrual_ids"
                               widget="many2many_tags"
                               nolabel="1"
                               options="{'no_create': True}"
                               domain="[('investment_id', '=', investment_id), ('state', '=', 'posted')]"/>
                    </group>

                    <!-- Selected accrual detail table -->
                    <field name="selected_accrual_ids"
                           mode="list"
                           invisible="payout_mode != 'select'"
                           nolabel="1"
                           string="Accruals to Pay in Full">
                        <list string="Accruals to Pay">
                            <field name="accrual_date"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="opening_balance" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="interest_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   sum="Total"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'posted'"/>
                            <field name="currency_id" invisible="1"/>
                        </list>
                    </field>

                    <!-- Partial amount entry -->
                    <group string="Custom Payout Amount"
                           invisible="payout_mode != 'partial'">
                        <field name="custom_gross_amount" widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               string="Gross Amount to Pay"/>
                        <div class="text-muted small" colspan="2"
                             invisible="payout_mode != 'partial'">
                            Maximum payable: <field name="total_outstanding"
                                                    widget="monetary"
                                                    options="{'currency_field': 'currency_id'}"
                                                    readonly="1" nolabel="1"
                                                    class="d-inline"/>
                            -- Accrual records will remain in <b>Posted</b> state;
                            only the payout amount is recorded.
                        </div>
                    </group>

                    <!-- Payout Summary -->
                    <group string="Payout Summary">
                        <group>
                            <field name="gross_interest" widget="monetary"
                                   options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="wht_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1" class="text-danger"/>
                        </group>
                        <group>
                            <field name="net_interest_payable" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1" class="h4 fw-bold text-success"
                                   string="Net Amount Paid to Investor"/>
                        </group>
                    </group>

                    <group string="Notes">
                        <field name="notes" nolabel="1"
                               placeholder="Optional notes for this payout…"/>
                    </group>

                </sheet>
                <footer>
                    <button name="action_confirm_payout"
                            string="Confirm Payout"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
