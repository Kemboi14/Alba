<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_investment_withdraw_wizard_form" model="ir.ui.view">
        <field name="name">alba.investment.withdraw.wizard.form</field>
        <field name="model">alba.investment.withdraw.wizard</field>
        <field name="arch" type="xml">
            <form string="Withdraw Investment">
                <sheet>

                    <!-- ── Hidden fields ──────────────────────────────────── -->
                    <field name="investment_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="is_premature" invisible="1"/>

                    <!-- ── Premature withdrawal warning ───────────────────── -->
                    <div class="alert alert-danger d-flex align-items-start gap-3 mb-3"
                         role="alert"
                         invisible="not is_premature"
                         style="border-left: 4px solid #dc3545; border-radius: 6px; padding: 14px 18px;">
                        <i class="fa fa-exclamation-triangle fa-2x text-danger me-3"/>
                        <div class="flex-grow-1">
                            <strong class="d-block" style="font-size: 1.1em;">
                                ⚠️ Premature Withdrawal — Interest Forfeiture Applies
                            </strong>
                            <span class="text-muted small">
                                This investment has not reached its maturity date.
                                Per Rule 4, the investor forfeits all interest accrued
                                in the <strong>current billing cycle</strong>.
                                Only principal, top-ups, and prior completed months'
                                interest (net of WHT) will be paid out.
                            </span>
                        </div>
                    </div>

                    <!-- ── Standard payout notice ─────────────────────────── -->
                    <div class="alert alert-info d-flex align-items-center gap-3 mb-3"
                         role="alert"
                         invisible="is_premature"
                         style="border-left: 4px solid #2E75B6; border-radius: 6px; padding: 14px 18px;">
                        <i class="fa fa-info-circle fa-2x text-primary me-3"/>
                        <div class="flex-grow-1">
                            <strong class="d-block" style="font-size: 1.1em;">Confirming Full Payout</strong>
                            <span class="text-muted small">
                                This will record the final payout to the investor
                                including all accrued interest, net of withholding tax (WHT).
                            </span>
                        </div>
                    </div>

                    <group>
                        <group string="Payout Components">
                            <field name="principal_amount" widget="monetary" readonly="1"/>
                            <field name="total_topup_amount" widget="monetary" readonly="1"
                                   invisible="not total_topup_amount"/>
                            <field name="eligible_gross_interest" widget="monetary" readonly="1"/>
                            <field name="forfeited_interest" widget="monetary" readonly="1"
                                   class="text-danger fw-bold"
                                   invisible="not is_premature"
                                   string="Forfeited Interest (Current Month)"/>
                            <field name="wht_rate" readonly="1"/>
                            <field name="wht_amount" widget="monetary" readonly="1"
                                   class="text-danger"/>
                            <field name="net_interest_payable" widget="monetary" readonly="1"
                                   class="text-success"/>
                            <hr colspan="2" style="border-top: 1px solid #ccc; margin: 10px 0;"/>
                            <field name="amount" widget="monetary" readonly="1"
                                   class="h3 fw-bold text-primary"/>
                        </group>
                        <group string="Payment Parameters">
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="payment_date"/>
                            <field name="earliest_withdrawal_date" readonly="1"
                                   invisible="not earliest_withdrawal_date"/>
                            <field name="days_to_withdrawal" readonly="1"
                                   invisible="not earliest_withdrawal_date"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_confirm_withdrawal"
                                string="Confirm Payout"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
