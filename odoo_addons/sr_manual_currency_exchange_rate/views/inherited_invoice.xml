<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_extends_add_manual_currency_exchange_rate" model="ir.ui.view">
            <field name="name">view.move.form.extends.add.manual.currency.exchange.rate</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <field name="invoice_date" position="after">
                    <field name="active_manual_currency_rate" invisible="1" />
                    <field name="apply_manual_currency_exchange"
                        invisible="active_manual_currency_rate == False"
                        readonly="state in ['posted', 'cancel']" />
<!--                    <field name="manual_currency_exchange_rate"-->
<!--                        invisible="apply_manual_currency_exchange == False or active_manual_currency_rate == False"-->
<!--                        required="apply_manual_currency_exchange == True"-->
<!--                        readonly="state in ['posted', 'cancel']" />-->
                </field>
                <xpath expr="//group/group[@id='header_right_group']/div[@name='journal_div']/div[@name='currency_div']/div[@name='currency_conversion_div']" position="replace">
                    <div name="currency_conversion_div" class="d-flex gap-1 text-muted" invisible="apply_manual_currency_exchange == False or active_manual_currency_rate == False">
                        <span>1</span>
                        <field name="company_currency_id" readonly="True" options="{'no_open': True}" class="w-auto"/>
                        <span>=</span>
                        <field name="invoice_currency_rate" digits="[12,6]" readonly="state != 'draft'"/>
                        <field name="currency_id" readonly="True" options="{'no_open': True}" class="w-auto"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>